# =====================================================================
# Ludeka - Configuración de Variables de Entorno (Staging / Producción)
# Copia este archivo como '.env' en el servidor VPS y completa los valores.
# =====================================================================

# Configuración del Entorno de Ejecución
ASPNETCORE_ENVIRONMENT=Production
PORT=5081

# Base de Datos SQLite (Persistente en el volumen /app/data de Docker)
ConnectionStrings__DefaultConnection=Data Source=/app/data/ludeka.db

# BoardGameGeek XMLAPI2 (Opcional - Requerido para auto-catalogación enriquecida en directo)
Bgg__ApiToken=
Bgg__BaseUrl=https://boardgamegeek.com/xmlapi2/
Bgg__UserAgent=LudekaApp/1.0 (https://ludeka.es; contacto@ludeka.es)

# Sistema de Notificaciones y Webhooks de Comunidad (Discord & Telegram)
# Establecer DryRun=false en producción para emitir mensajes reales
CommunityNotifications__Enabled=true
CommunityNotifications__DryRun=false

# Discord Webhook Oficial de la Comunidad
CommunityNotifications__DiscordEnabled=true
CommunityNotifications__DiscordWebhookUrl=

# Telegram Bot API (Token emitido por @BotFather y Chat ID del canal/grupo)
CommunityNotifications__TelegramEnabled=true
CommunityNotifications__TelegramBotToken=
CommunityNotifications__TelegramChatId=
