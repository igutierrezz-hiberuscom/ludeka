@inherits LayoutComponentBase
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<div class="min-h-screen flex flex-col bg-[#121418] text-[#F3F4F6]">
    <a href="#main-content" class="skip-link sr-only focus:not-sr-only">
        Saltar al contenido principal
    </a>
    <header class="header-nav">
        <div class="container-ludeka flex items-center justify-between h-16">
            <a href="/" class="logo-badge flex items-center gap-2.5">
                <img src="/images/logo.png" alt="Logotipo de Ludeka" width="36" height="36" decoding="async" class="h-9 w-auto object-contain drop-shadow" />
                <span class="font-extrabold tracking-tight text-xl text-white">Ludeka<span class="dot text-orange-500">.</span></span>
            </a>

            <nav class="flex items-center gap-3 sm:gap-4 text-sm font-medium">
                @* Selector demostrativo de rol *@
                <button type="button"
                        @onclick="ToggleUserRole"
                        title="Alternar entre rol de la Mesa Fundadora y rol de Usuario Comunitario"
                        aria-label="Alternar rol entre Mesa Fundadora y Usuario Comunitario"
                        class="px-2.5 py-1 rounded-full border text-xs font-bold transition-all flex items-center gap-1.5 @(CurrentUserService.IsFoundingTeam ? "bg-orange-950/80 border-orange-500/40 text-orange-300 shadow-sm" : "bg-white/[0.05] border-white/10 text-slate-300 hover:text-white hover:bg-white/[0.08]")">
                    <span>@(CurrentUserService.IsFoundingTeam ? "🛡️ Mesa Fundadora" : "👤 Usuario")</span>
                    <span class="text-[0.65rem] opacity-70 underline">Cambiar</span>
                </button>

                <a href="/" class="text-slate-300 hover:text-white transition-colors text-xs sm:text-sm font-semibold">
                    Catálogo
                </a>
                <a href="/radar" class="text-slate-300 hover:text-orange-400 transition-colors text-xs sm:text-sm flex items-center gap-1 font-semibold">
                    <span>📡</span>
                    <span>Radar & Sorteos</span>
                </a>
                <a href="/mi-ludoteca" class="px-3 py-1.5 rounded-full bg-emerald-950/60 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-900/60 transition-all flex items-center gap-1.5 text-xs font-bold shadow-sm">
                    <span>📚</span>
                    <span class="hidden sm:inline">Mi Ludoteca</span>
                </a>
                @if (CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator"))
                {
                    <a href="/moderacion-media" class="px-2.5 py-1.5 rounded-full bg-orange-950/60 border border-orange-500/30 text-orange-300 hover:bg-orange-900/60 transition-all flex items-center gap-1.5 text-xs font-bold shadow-sm">
                        <span>🎬</span>
                        <span class="hidden sm:inline">Moderar Medios</span>
                    </a>
                }
            </nav>
        </div>
    </header>

    <main class="flex-1" id="main-content" tabindex="-1">
        @Body
    </main>

    <footer class="mt-auto border-t border-white/[0.06] bg-[#0E1013] py-8 text-xs text-slate-400">
        <div class="container-ludeka flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
                <p class="font-bold text-slate-300">Ludeka &copy; 2026</p>
                <p class="text-slate-400">Catálogo y comunidad abierta de juegos de mesa en español.</p>
            </div>
            <div class="flex items-center gap-4 text-xs font-semibold">
                <a href="/transparencia" class="text-slate-400 hover:text-orange-400 transition-colors">
                    🛡️ Transparencia
                </a>
                <span class="text-slate-700">&bull;</span>
                <a href="/radar" class="text-slate-400 hover:text-orange-400 transition-colors">
                    📡 Radar de Sorteos
                </a>
                <span class="text-slate-700">&bull;</span>
                <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-indigo-400 transition-colors">
                    💬 Discord
                </a>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" class="hidden">
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void ToggleUserRole()
    {
        if (CurrentUserService.IsFoundingTeam)
        {
            CurrentUserService.SwitchRole("User");
        }
        else
        {
            CurrentUserService.SwitchRole("FoundingTeam");
        }

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
