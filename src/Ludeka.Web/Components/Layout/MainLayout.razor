@inherits LayoutComponentBase
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="min-h-screen flex flex-col bg-[var(--bg-main)] text-[var(--text-primary)] transition-colors duration-200">
    <a href="#main-content" class="skip-link sr-only focus:not-sr-only">
        Saltar al contenido principal
    </a>
    <header class="header-nav">
        <div class="container-ludeka flex items-center justify-between h-16">
            <a href="/" class="logo-badge flex items-center gap-2.5">
                <img src="/images/logo.png" alt="Logotipo de Ludeka" width="36" height="36" decoding="async" class="h-9 w-auto object-contain drop-shadow" />
                <span class="font-extrabold tracking-tight text-xl text-[var(--text-primary)]">Ludeka<span class="dot text-[var(--brand-primary)]">.</span></span>
            </a>

            <div class="flex items-center gap-2 sm:gap-3">
                @* Selector de paletas / temas (Opciones A, B, C y Carbón) *@
                <div class="flex items-center bg-[var(--bg-surface-elevated)] p-0.5 rounded-full border border-[var(--border-subtle)]" role="group" aria-label="Selector de paleta de colores">
                    <button type="button"
                            @onclick='() => SwitchTheme("editorial")'
                            title="Opción A: Editorial Claro (Papel & Tinta)"
                            aria-label="Tema Editorial Claro"
                            class="px-2 py-1 rounded-full text-xs font-semibold transition-all flex items-center gap-1 @(CurrentTheme == "editorial" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                        <span>📖</span>
                        <span class="hidden lg:inline text-[0.7rem]">Papel</span>
                    </button>
                    <button type="button"
                            @onclick='() => SwitchTheme("tabletop")'
                            title="Opción B: Mesa Cálida (Madera & Tapete)"
                            aria-label="Tema Mesa Cálida"
                            class="px-2 py-1 rounded-full text-xs font-semibold transition-all flex items-center gap-1 @(CurrentTheme == "tabletop" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                        <span>🎲</span>
                        <span class="hidden lg:inline text-[0.7rem]">Mesa</span>
                    </button>
                    <button type="button"
                            @onclick='() => SwitchTheme("midnight")'
                            title="Opción C: Azul Medianoche (Cian & Lima)"
                            aria-label="Tema Azul Medianoche"
                            class="px-2 py-1 rounded-full text-xs font-semibold transition-all flex items-center gap-1 @(CurrentTheme == "midnight" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                        <span>🌌</span>
                        <span class="hidden lg:inline text-[0.7rem]">Noche</span>
                    </button>
                    <button type="button"
                            @onclick='() => SwitchTheme("charcoal")'
                            title="Original: Carbón Oscuro & Naranja"
                            aria-label="Tema Carbón Oscuro"
                            class="px-2 py-1 rounded-full text-xs font-semibold transition-all flex items-center gap-1 @(CurrentTheme == "charcoal" ? "bg-[var(--brand-primary)] text-white shadow-sm" : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                        <span>🌑</span>
                        <span class="hidden lg:inline text-[0.7rem]">Carbón</span>
                    </button>
                </div>

                <nav class="flex items-center gap-2 sm:gap-3 text-sm font-medium">
                    @* Selector demostrativo de rol *@
                    <button type="button"
                            @onclick="ToggleUserRole"
                            title="Alternar entre rol de la Mesa Fundadora y rol de Usuario Comunitario"
                            aria-label="Alternar rol entre Mesa Fundadora y Usuario Comunitario"
                            class="px-2.5 py-1 rounded-full border text-xs font-bold transition-all flex items-center gap-1.5 @(CurrentUserService.IsFoundingTeam ? "bg-[var(--brand-primary)] border-[var(--brand-primary)] text-white shadow-sm" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                        <span>@(CurrentUserService.IsFoundingTeam ? "🛡️ Mesa" : "👤 Usuario")</span>
                        <span class="text-[0.65rem] opacity-80 underline">Cambiar</span>
                    </button>

                    <a href="/" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors text-xs sm:text-sm font-semibold">
                        Catálogo
                    </a>
                    <a href="/radar" class="text-[var(--text-secondary)] hover:text-[var(--brand-primary)] transition-colors text-xs sm:text-sm flex items-center gap-1 font-semibold">
                        <span>📡</span>
                        <span class="hidden sm:inline">Radar</span>
                    </a>
                    <a href="/mi-ludoteca" class="px-2.5 py-1.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] border border-[var(--border-subtle)] hover:border-[var(--border-highlight)] transition-all flex items-center gap-1.5 text-xs font-semibold shadow-sm">
                        <span>📚</span>
                        <span class="hidden sm:inline">Mi Ludoteca</span>
                    </a>
                    @if (CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator"))
                    {
                        <a href="/moderacion-media" class="px-2.5 py-1.5 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all flex items-center gap-1.5 text-xs font-semibold shadow-sm">
                            <span>🎬</span>
                            <span class="hidden sm:inline">Moderar</span>
                        </a>
                        <a href="/admin/notificaciones" class="px-2.5 py-1.5 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--brand-primary)] transition-all flex items-center gap-1.5 text-xs font-semibold shadow-sm" title="Panel de Notificaciones y Webhooks de Comunidad">
                            <span>🔔</span>
                            <span class="hidden sm:inline">Webhooks</span>
                        </a>
                    }
                </nav>
            </div>
        </div>
    </header>

    <main class="flex-1" id="main-content" tabindex="-1">
        @Body
    </main>

    <footer class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-8 text-xs text-[var(--text-secondary)]">
        <div class="container-ludeka flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
                <p class="font-bold text-[var(--text-primary)]">Ludeka &copy; 2026</p>
                <p class="text-[var(--text-secondary)]">Catálogo y comunidad abierta de juegos de mesa en español.</p>
            </div>
            <div class="flex items-center gap-4 text-xs font-semibold">
                <a href="/transparencia" class="text-[var(--text-secondary)] hover:text-[var(--brand-primary)] transition-colors">
                    🛡️ Transparencia
                </a>
                <span class="text-[var(--text-muted)]">&bull;</span>
                <a href="/radar" class="text-[var(--text-secondary)] hover:text-[var(--brand-primary)] transition-colors">
                    📡 Radar de Sorteos
                </a>
                <span class="text-[var(--text-muted)]">&bull;</span>
                <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="text-[var(--text-secondary)] hover:text-indigo-400 transition-colors">
                    💬 Discord
                </a>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" class="hidden">
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string CurrentTheme = "charcoal";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string>("getLudekaTheme");
                if (!string.IsNullOrWhiteSpace(stored) && stored != CurrentTheme)
                {
                    CurrentTheme = stored;
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignorar en entornos donde JS aún no esté disponible
            }
        }
    }

    private async Task SwitchTheme(string theme)
    {
        CurrentTheme = theme;
        try
        {
            await JS.InvokeVoidAsync("setLudekaTheme", theme);
        }
        catch
        {
        }
    }

    private void ToggleUserRole()
    {
        if (CurrentUserService.IsFoundingTeam)
        {
            CurrentUserService.SwitchRole("User");
        }
        else
        {
            CurrentUserService.SwitchRole("FoundingTeam");
        }

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
