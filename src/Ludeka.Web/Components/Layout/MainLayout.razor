@inherits LayoutComponentBase
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<div class="min-h-screen flex flex-col bg-[#0B0F17] text-[#F3F4F6]">
    <header class="header-nav">
        <div class="container-ludeka flex items-center justify-between h-16">
            <a href="/" class="logo-badge flex items-center gap-2.5">
                <img src="/images/logo.png" alt="Logotipo de Ludeka" class="h-9 w-auto object-contain drop-shadow" />
                <span class="font-extrabold tracking-tight text-lg sm:text-xl text-white">Ludeka<span class="dot text-orange-500">.</span></span>
                <span class="hidden sm:inline-block text-[0.68rem] font-semibold tracking-normal text-slate-400 uppercase bg-slate-800/80 px-2 py-0.5 rounded-full border border-slate-700/50">
                    El Letterboxd de los juegos de mesa
                </span>
            </a>

            <nav class="flex items-center gap-3 sm:gap-4 text-sm font-medium">
                @* Selector demostrativo de rol *@
                <button type="button"
                        @onclick="ToggleUserRole"
                        title="Alternar entre rol de la Mesa Fundadora y rol de Usuario Comunitario"
                        class="px-2.5 py-1 rounded-lg border text-xs font-bold transition-all flex items-center gap-1.5 @(CurrentUserService.IsFoundingTeam ? "bg-orange-950/80 border-orange-500/50 text-orange-300 shadow-sm" : "bg-slate-800/80 border-slate-700 text-slate-400 hover:text-slate-200")">
                    <span>@(CurrentUserService.IsFoundingTeam ? "🛡️ Mesa Fundadora" : "👤 Usuario")</span>
                    <span class="text-[0.65rem] opacity-70 underline">Cambiar</span>
                </button>

                <a href="/" class="text-slate-300 hover:text-white transition-colors text-xs sm:text-sm">
                    Catálogo
                </a>
                <a href="/radar" class="text-slate-300 hover:text-orange-400 transition-colors text-xs sm:text-sm flex items-center gap-1">
                    <span>📡</span>
                    <span>Radar & Sorteos</span>
                </a>
                <a href="/mi-ludoteca" class="px-3 py-1.5 rounded-xl bg-emerald-950/80 text-emerald-300 border border-emerald-500/40 hover:bg-emerald-900/80 transition-all flex items-center gap-1.5 text-xs font-bold shadow-sm">
                    <span>📚</span>
                    <span class="hidden sm:inline">Mi Ludoteca</span>
                </a>
                @if (CurrentUserService.IsFoundingTeam || CurrentUserService.IsInRole("Moderator"))
                {
                    <a href="/moderacion/multimedia" class="px-2.5 py-1.5 rounded-xl bg-orange-950/80 border border-orange-500/40 text-orange-300 hover:bg-orange-900/80 transition-all flex items-center gap-1.5 text-xs font-bold shadow-sm">
                        <span>🎬</span>
                        <span class="hidden sm:inline">Moderar Medios</span>
                    </a>
                }
                <a href="/?parejas=true" class="text-slate-400 hover:text-orange-400 transition-colors hidden md:inline text-xs sm:text-sm">
                    Especial Parejas
                </a>
                <a href="/?familiar=true" class="text-slate-400 hover:text-orange-400 transition-colors hidden md:inline text-xs sm:text-sm">
                    Mesa Familiar
                </a>
            </nav>
        </div>
    </header>

    <main class="flex-1">
        @Body
    </main>

    <footer class="mt-auto border-t border-slate-800/80 bg-slate-950/60 py-8 text-xs text-slate-500">
        <div class="container-ludeka flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
                <p class="font-bold text-slate-400">Ludeka &bull; Ludist MVP (Completado: Catálogo, Ludoteca, Veredicto, Multimedia, BGG y Comunidad)</p>
                <p>El Letterboxd de los juegos de mesa en español. Sin anuncios invasivos &bull; 100% de código abierto.</p>
                <div class="flex items-center gap-4 mt-2">
                    <a href="/transparencia" class="text-slate-400 hover:text-orange-400 font-bold transition-colors">
                        🛡️ Manifiesto de Transparencia
                    </a>
                    <span>&bull;</span>
                    <a href="/radar" class="text-slate-400 hover:text-orange-400 font-bold transition-colors">
                        📡 Radar de Sorteos
                    </a>
                    <span>&bull;</span>
                    <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-indigo-400 font-bold transition-colors">
                        💬 Discord Oficial
                    </a>
                </div>
            </div>
            <div class="text-center sm:text-right">
                <p class="italic text-slate-400">"De jugón a jugón &bull; Lectura en 3 segundos &bull; Semáforo hasta 7+ comensales"</p>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" class="hidden">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void ToggleUserRole()
    {
        if (CurrentUserService.IsFoundingTeam)
        {
            CurrentUserService.SwitchRole("User");
        }
        else
        {
            CurrentUserService.SwitchRole("FoundingTeam");
        }

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
