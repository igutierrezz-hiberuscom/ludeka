@page "/mi-ludoteca"
@rendermode InteractiveServer
@inject IUserLibraryService LibraryService
@inject NavigationManager Navigation

<PageTitle>Mi Ludoteca Personal — Ludeka</PageTitle>

<div class="container-ludeka py-8 space-y-8">
    @* Cabecera de la sección *@
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-[var(--border-subtle)] pb-6">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">
                    Tu Espacio Lúdico
                </span>
                <span class="text-xs text-[var(--text-secondary)]">Sesión activa como <strong class="text-[var(--text-primary)]">Mesa Fundadora</strong></span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
                Mi Ludoteca Personal
            </h1>
            <p class="text-sm text-[var(--text-secondary)] mt-1">
                Gestiona tus copias físicas en propiedad, títulos jugados, deseos y el cuaderno de préstamos ("¿A quién se lo dejé?").
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    @onclick="() => _showBggImportModal = true"
                    class="px-4 py-2 rounded-xl text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-all inline-flex items-center gap-1.5 shadow-sm">
                <span>📥</span>
                <span>Importar BGG</span>
            </button>
            <button type="button"
                    @onclick="() => _showBggSearchModal = true"
                    class="px-4 py-2 rounded-xl text-xs font-bold bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-subtle)] transition-colors inline-flex items-center gap-1.5 shadow-sm">
                <span>🎲</span>
                <span>+ Añadir por BGG</span>
            </button>
            <a href="/" class="px-4 py-2 rounded-xl text-xs font-bold bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-subtle)] transition-colors inline-flex items-center gap-1.5 shadow-sm">
                <span>🔍</span>
                <span>Explorar Catálogo</span>
            </a>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="py-20 text-center text-[var(--text-secondary)]">
            <div class="inline-block animate-spin text-4xl mb-3">🎲</div>
            <p class="text-base font-semibold">Cargando tu ludoteca...</p>
        </div>
    }
    else if (_summary != null)
    {
        @* Pestañas Horizontales *@
        <div class="flex flex-wrap gap-2 border-b border-[var(--border-subtle)] pb-2" role="tablist" aria-label="Secciones de la ludoteca personal">
            <button type="button"
                    id="tab-incollection"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.InCollection ? "true" : "false")"
                    aria-controls="panel-collection"
                    @onclick="() => _activeTab = TabType.InCollection"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.InCollection)">
                <span>📚 En mi ludoteca</span>
                <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-black @GetBadgeClass(TabType.InCollection)">
                    @_summary.TotalInCollection
                </span>
            </button>

            <button type="button"
                    id="tab-played"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.Played ? "true" : "false")"
                    aria-controls="panel-collection"
                    @onclick="() => _activeTab = TabType.Played"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.Played)">
                <span>🎲 Jugados</span>
                <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-black @GetBadgeClass(TabType.Played)">
                    @_summary.TotalPlayed
                </span>
            </button>

            <button type="button"
                    id="tab-wishlist"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.Wishlist ? "true" : "false")"
                    aria-controls="panel-collection"
                    @onclick="() => _activeTab = TabType.Wishlist"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.Wishlist)">
                <span>🔖 Deseados</span>
                <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-black @GetBadgeClass(TabType.Wishlist)">
                    @_summary.TotalWishlist
                </span>
            </button>

            <button type="button"
                    id="tab-wanttobuy"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.WantToBuy ? "true" : "false")"
                    aria-controls="panel-collection"
                    @onclick="() => _activeTab = TabType.WantToBuy"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.WantToBuy)">
                <span>🛒 Comprar</span>
                <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-black @GetBadgeClass(TabType.WantToBuy)">
                    @_summary.TotalWantToBuy
                </span>
            </button>

            <button type="button"
                    id="tab-loans"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.Loans ? "true" : "false")"
                    aria-controls="panel-loans"
                    @onclick="() => _activeTab = TabType.Loans"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.Loans)">
                <span>📦 Préstamos</span>
                <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-black @GetBadgeClass(TabType.Loans)">
                    @_summary.TotalActiveLoans
                </span>
            </button>

            <button type="button"
                    id="tab-queue"
                    role="tab"
                    aria-selected="@(_activeTab == TabType.Queue ? "true" : "false")"
                    aria-controls="panel-queue"
                    @onclick="() => _activeTab = TabType.Queue"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @GetTabClass(TabType.Queue)">
                <span>⏳ Cola comunitaria</span>
            </button>
        </div>

        @* Contenido de la pestaña activa *@
        @if (_activeTab == TabType.Queue)
        {
            <div id="panel-queue" role="tabpanel" aria-labelledby="tab-queue">
                <CatalogQueuePanel OnQueueProcessed="LoadSummaryAsync" />
            </div>
        }
        else if (_activeTab == TabType.Loans)
        {
            @* Vista de Préstamos Activos *@
            <div id="panel-loans" role="tabpanel" aria-labelledby="tab-loans">
                @if (_summary.ActiveLoans.Count == 0)
                {
                    <div class="py-16 text-center max-w-md mx-auto p-8 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                        <span class="text-4xl block mb-3">🤝</span>
                        <h3 class="text-lg font-bold text-[var(--text-primary)] mb-1">Todos tus juegos están a buen recaudo</h3>
                        <p class="text-xs text-[var(--text-secondary)]">
                            No tienes ningún juego prestado en este momento. Cuando le dejes un título a un amigo o asociación, regístralo desde su ficha.
                        </p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var loan in _summary.ActiveLoans)
                        {
                            <div class="p-5 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex flex-col justify-between gap-4">
                                <div class="flex gap-4 items-start">
                                    <a href="/juegos/@loan.GameSlug" class="shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-surface)] block">
                                        @if (!string.IsNullOrWhiteSpace(loan.GameCoverUrl))
                                        {
                                            <img src="@loan.GameCoverUrl" alt="@loan.GameTitle" loading="lazy" decoding="async" width="80" height="80" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center text-xs text-[var(--text-muted)]">🎲</div>
                                        }
                                    </a>

                                <div class="flex-1 min-w-0">
                                    <a href="/juegos/@loan.GameSlug" class="text-sm font-black text-[var(--text-primary)] hover:text-[var(--brand-primary)] transition-colors block truncate">
                                        @loan.GameTitle
                                    </a>
                                    <div class="mt-2 space-y-1">
                                        <div class="flex items-center gap-1.5 text-xs text-[var(--brand-primary)] font-bold">
                                            <span>👤</span>
                                            <span>@loan.BorrowerName</span>
                                        </div>
                                        <div class="text-[0.68rem] text-[var(--text-secondary)]">
                                            Prestado el @loan.LoanDate.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(loan.Notes))
                                    {
                                        <p class="text-[0.68rem] text-[var(--text-secondary)] mt-2 italic line-clamp-2">
                                            &ldquo;@loan.Notes&rdquo;
                                        </p>
                                    }
                                </div>
                            </div>

                            <button type="button"
                                    @onclick="() => HandleReturnLoan(loan.Id)"
                                    class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-colors flex items-center justify-center gap-1.5 shadow-sm">
                                <span>↩️</span>
                                <span>Marcar como devuelto</span>
                            </button>
                        </div>
                    }
                    </div>
                }
            </div>
        }
        else
        {
            @* Vista de Juegos por Estado *@
            <div id="panel-collection" role="tabpanel" aria-labelledby="@($"tab-{_activeTab.ToString().ToLowerInvariant()}")">
                @{
                    var currentList = GetFilteredItems();
                }

                @if (currentList.Count == 0)
                {
                    <div class="py-16 text-center max-w-md mx-auto p-8 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
                        <span class="text-4xl block mb-3">🎲</span>
                        <h3 class="text-lg font-bold text-[var(--text-primary)] mb-1">Sin juegos en esta lista</h3>
                        <p class="text-xs text-[var(--text-secondary)] mb-6">
                            Aún no tienes ningún título clasificado como @GetActiveTabName(). Puedes importar tu colección desde BGG o añadir juegos con el buscador.
                        </p>
                        <div class="flex justify-center gap-3">
                            <button type="button"
                                    @onclick="() => _showBggImportModal = true"
                                    class="px-4 py-2.5 rounded-xl text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-colors shadow-sm">
                                Importar desde BGG
                            </button>
                            <a href="/" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-subtle)] transition-colors">
                                Explorar Catálogo
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
                        @foreach (var item in currentList)
                        {
                            <div class="group relative rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] hover:border-[var(--brand-primary)] overflow-hidden flex flex-col transition-all shadow-sm">
                                @if (item.IsPendingCataloging)
                                {
                                    <div class="block aspect-square w-full overflow-hidden bg-[var(--bg-surface-elevated)] relative">
                                        @if (!string.IsNullOrWhiteSpace(item.GameCoverUrl))
                                        {
                                            <img src="@item.GameCoverUrl" alt="@item.GameTitle" loading="lazy" decoding="async" width="200" height="200" class="w-full h-full object-cover opacity-80" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center text-[var(--text-muted)] text-2xl font-bold">🎲</div>
                                        }

                                        <div class="absolute top-2 left-2 right-2 px-2 py-1 rounded-md bg-[var(--bg-nav)] text-[var(--brand-primary)] border border-[var(--border-subtle)] text-[0.6rem] font-bold uppercase tracking-wider backdrop-blur-sm z-10 flex items-center gap-1 shadow-sm">
                                            <span>⏳</span>
                                            <span class="truncate">En cola de catalogación</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <a href="/juegos/@item.GameSlug" class="block aspect-square w-full overflow-hidden bg-[var(--bg-surface-elevated)] relative">
                                        @if (!string.IsNullOrWhiteSpace(item.GameCoverUrl))
                                        {
                                            <img src="@item.GameCoverUrl" alt="@item.GameTitle" loading="lazy" decoding="async" width="200" height="200" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center text-[var(--text-muted)] text-2xl font-bold">🎲</div>
                                        }

                                        @if (item.IsCurrentlyLoaned)
                                        {
                                            <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-[var(--bg-nav)] text-[var(--text-primary)] border border-[var(--border-highlight)] text-[0.62rem] font-bold uppercase tracking-wider backdrop-blur-sm z-10">
                                                📦 Prestado
                                            </div>
                                        }
                                    </a>
                                }

                                <div class="p-3 flex-1 flex flex-col justify-between gap-2">
                                    <div>
                                        @if (item.IsPendingCataloging)
                                        {
                                            <div class="text-xs font-bold text-[var(--text-secondary)] line-clamp-2" title="@item.GameTitle">
                                                @item.GameTitle
                                            </div>
                                            <span class="text-[0.62rem] text-[var(--brand-primary)] font-medium block mt-0.5">
                                                ⏳ Auto-catalogación pendiente
                                            </span>
                                        }
                                        else
                                        {
                                            <a href="/juegos/@item.GameSlug" class="text-xs font-bold text-[var(--text-primary)] hover:text-[var(--brand-primary)] transition-colors line-clamp-2">
                                                @item.GameTitle
                                            </a>
                                        }
                                    </div>
                                    <div class="text-[0.62rem] text-[var(--text-muted)] font-medium">
                                        Añadido el @item.AddedAt.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@* Modales interactivos *@
<BggImportModal IsVisible="_showBggImportModal" 
                OnClose="() => _showBggImportModal = false" 
                OnImportCompleted="LoadSummaryAsync" />

<BggSearchModal IsVisible="_showBggSearchModal" 
                OnClose="() => _showBggSearchModal = false" 
                OnGameAdded="LoadSummaryAsync" />

@code {
    private enum TabType
    {
        InCollection,
        Played,
        Wishlist,
        WantToBuy,
        Loans,
        Queue
    }

    private TabType _activeTab = TabType.InCollection;
    private UserLibrarySummaryDto? _summary;
    private bool _isLoading = true;
    private bool _showBggImportModal = false;
    private bool _showBggSearchModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        _isLoading = true;
        _summary = await LibraryService.GetLibrarySummaryAsync();
        _isLoading = false;
    }

    private async Task HandleReturnLoan(Guid loanId)
    {
        await LibraryService.ReturnLoanAsync(loanId);
        await LoadSummaryAsync();
    }

    private List<UserCollectionItemDto> GetFilteredItems()
    {
        if (_summary == null) return [];

        var targetStatus = _activeTab switch
        {
            TabType.InCollection => CollectionStatus.InCollection,
            TabType.Played => CollectionStatus.Played,
            TabType.Wishlist => CollectionStatus.Wishlist,
            TabType.WantToBuy => CollectionStatus.WantToBuy,
            _ => CollectionStatus.InCollection
        };

        return _summary.Items.Where(i => i.Status == targetStatus).ToList();
    }

    private string GetActiveTabName() => _activeTab switch
    {
        TabType.InCollection => "«En mi ludoteca»",
        TabType.Played => "«Jugado»",
        TabType.Wishlist => "«Deseado»",
        TabType.WantToBuy => "«Quiero comprar»",
        TabType.Loans => "«Préstamos»",
        TabType.Queue => "«Cola comunitaria»",
        _ => ""
    };

    private string GetTabClass(TabType tab)
    {
        bool isActive = _activeTab == tab;
        if (isActive)
        {
            return "bg-[var(--brand-primary)] text-white shadow-sm";
        }
        return "bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)]";
    }

    private string GetBadgeClass(TabType tab)
    {
        bool isActive = _activeTab == tab;
        if (isActive)
        {
            return "bg-black/20 text-white";
        }
        return "bg-[var(--bg-card)] text-[var(--text-muted)]";
    }
}
