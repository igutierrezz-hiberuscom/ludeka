@page "/not-found"
@layout MainLayout

<PageTitle>Página no encontrada | Ludeka</PageTitle>

<div class="container-ludeka py-24 text-center max-w-md mx-auto space-y-4">
    <span class="text-6xl block animate-bounce">🎲</span>
    <h1 class="text-2xl font-black text-[var(--text-primary)] tracking-tight">Página no encontrada</h1>
    <p class="text-sm text-[var(--text-secondary)]">
        La ruta a la que intentas acceder no existe en la ludoteca o ha cambiado de lugar.
    </p>
    <div class="pt-4">
        <a href="/" class="px-4 py-2 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-white font-bold text-xs transition-all inline-flex items-center gap-1.5 shadow-sm">
            <span>&larr;</span> Volver al Catálogo
        </a>
    </div>
</div>