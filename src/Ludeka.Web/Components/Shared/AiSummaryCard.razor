@using Ludeka.Application.DTOs

<div class="rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] p-5 sm:p-6 shadow-sm">
    @* Cabecera *@
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--border-subtle)]">
        <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">
                <span>📋</span> Síntesis Editorial
            </span>
            <span class="text-xs text-[var(--text-muted)] font-medium">
                Consenso de la comunidad
            </span>
        </div>
        <div class="text-[0.68rem] text-[var(--text-muted)] flex items-center gap-1">
            <span>⚡ Análisis del hobby</span>
        </div>
    </div>

    @* Contenido estructurado *@
    <div class="mt-4 space-y-4 text-xs sm:text-sm">
        <p class="text-[var(--text-secondary)] leading-relaxed font-normal">
            @Summary.GeneralVerdict
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-2">
            @* Escalabilidad *@
            <div class="p-3.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-1.5">
                    <span>👥</span> Escalabilidad
                </span>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                    @Summary.ScalabilitySummary
                </p>
            </div>

            @* Edad Real *@
            <div class="p-3.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-1.5">
                    <span>🧒</span> Accesibilidad & Edad
                </span>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                    @Summary.AgeSummary
                </p>
            </div>

            @* Huella en mesa *@
            <div class="p-3.5 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-1">
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-1.5">
                    <span>📐</span> Espacio y Tiempo
                </span>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                    @Summary.FootprintSummary
                </p>
            </div>
        </div>

        @* Banner informativo del ciclo editorial *@
        <div class="p-3 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[0.72rem] text-[var(--text-muted)] flex items-start gap-2.5">
            <span class="text-base shrink-0">⏳</span>
            <p>
                <strong class="text-[var(--text-secondary)]">Ciclo Editorial Ludeka:</strong> Síntesis preliminar del consenso lúdico internacional. En cuanto nuestro equipo publique su veredicto oficial con fotos de partida, este bloque será actualizado.
            </p>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public AiGameSummaryDto Summary { get; set; } = null!;
}
