@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@inject IBggImportService BggImportService

@if (IsVisible)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm animate-fadeIn"
         role="dialog" aria-modal="true" aria-labelledby="bgg-import-modal-title">
        <div class="bg-slate-900 border border-slate-700/80 rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden flex flex-col">
            
            @* Cabecera del modal *@
            <div class="px-6 py-5 border-b border-slate-800 flex items-center justify-between bg-slate-900/50">
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">📥</span>
                    <div>
                        <h3 id="bgg-import-modal-title" class="text-lg font-black text-white tracking-tight">
                            Importar desde BoardGameGeek
                        </h3>
                        <p class="text-xs text-slate-400">Sincroniza tus juegos de mesa en 1 clic</p>
                    </div>
                </div>
                <button type="button" 
                        @onclick="Close"
                        class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition-colors"
                        aria-label="Cerrar modal de importación">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @* Cuerpo del modal *@
            <div class="p-6 space-y-5">
                @if (_isProcessing)
                {
                    <div class="py-12 text-center space-y-4">
                        <div class="inline-block animate-bounce text-5xl">🎲</div>
                        <h4 class="text-base font-bold text-white">Sincronizando con BoardGameGeek...</h4>
                        <p class="text-xs text-slate-400 max-w-sm mx-auto">
                            Estamos descargando tu colección y cruzándola con el catálogo oficial de Ludeka. Esto puede tomar unos instantes si BGG está preparando su caché.
                        </p>
                        <div class="w-48 h-1.5 bg-slate-800 rounded-full mx-auto overflow-hidden">
                            <div class="h-full bg-emerald-500 rounded-full animate-pulse w-3/4"></div>
                        </div>
                    </div>
                }
                else if (_result != null)
                {
                    <div class="space-y-4">
                        <div class="p-4 rounded-xl bg-emerald-950/40 border border-emerald-500/30 text-center">
                            <span class="text-3xl block mb-2">🎉</span>
                            <h4 class="text-base font-black text-emerald-300">¡Colección sincronizada con éxito!</h4>
                            <p class="text-xs text-emerald-400/80 mt-1">
                                Procesados un total de <strong>@_result.TotalProcessed</strong> juegos de tu perfil.
                            </p>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/60 text-center">
                                <span class="text-2xl block mb-1">🟢</span>
                                <div class="text-2xl font-black text-white">@_result.ImportedToCollection</div>
                                <div class="text-xs font-semibold text-slate-400 mt-0.5">En tu ludoteca ahora</div>
                            </div>
                            <div class="p-4 rounded-xl bg-amber-950/30 border border-amber-500/30 text-center">
                                <span class="text-2xl block mb-1">⏳</span>
                                <div class="text-2xl font-black text-amber-300">@_result.EnqueuedForCataloging</div>
                                <div class="text-xs font-semibold text-amber-400/90 mt-0.5">En cola de catalogación</div>
                            </div>
                        </div>

                        <p class="text-[0.75rem] text-slate-400 bg-slate-800/40 p-3 rounded-xl border border-slate-700/40 leading-relaxed">
                            💡 <strong>¿Qué son los juegos en cola?</strong> Son títulos que aún no tienen ficha oficial en Ludeka. Ya puedes gestionarlos y prestarles, y nuestro motor de auto-catalogación creará su ficha oficial pronto.
                        </p>

                        @if (_result.Errors.Count > 0)
                        {
                            <div class="p-3 bg-red-950/40 border border-red-800/50 rounded-xl text-xs text-red-300">
                                <strong>Avisos durante la importación (@_result.Errors.Count):</strong>
                                <ul class="list-disc list-inside mt-1 space-y-0.5">
                                    @foreach (var err in _result.Errors.Take(3))
                                    {
                                        <li class="truncate">@err</li>
                                    }
                                </ul>
                            </div>
                        }

                        <button type="button" 
                                @onclick="CloseAndRefresh"
                                class="w-full py-3 px-4 rounded-xl font-bold text-sm bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-colors shadow-lg shadow-emerald-500/20">
                            ¡Ver mi ludoteca actualizada!
                        </button>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        <div>
                            <label for="bgg-username" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                                Usuario de BoardGameGeek
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500 text-sm">👤</span>
                                <input id="bgg-username" 
                                       type="text" 
                                       @bind="_username" 
                                       @bind:event="oninput"
                                       placeholder="Ej. ludomaster99"
                                       class="w-full pl-10 pr-4 py-2.5 bg-slate-800/90 border border-slate-700 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all" />
                            </div>
                        </div>

                        <div class="space-y-2 pt-1">
                            <span class="block text-xs font-bold text-slate-300 uppercase tracking-wider">
                                Listas a Importar
                            </span>
                            <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-800/40 border border-slate-800 hover:border-slate-700 cursor-pointer transition-colors">
                                <input type="checkbox" @bind="_importOwned" class="w-4 h-4 rounded text-emerald-500 bg-slate-700 border-slate-600 focus:ring-emerald-500 focus:ring-offset-slate-900" />
                                <div class="text-xs">
                                    <strong class="text-white block">Juegos en propiedad (Owned)</strong>
                                    <span class="text-slate-400">Se añadirán a tu pestaña <em>🟢 En mi ludoteca</em></span>
                                </div>
                            </label>
                            <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-800/40 border border-slate-800 hover:border-slate-700 cursor-pointer transition-colors">
                                <input type="checkbox" @bind="_importWishlist" class="w-4 h-4 rounded text-emerald-500 bg-slate-700 border-slate-600 focus:ring-emerald-500 focus:ring-offset-slate-900" />
                                <div class="text-xs">
                                    <strong class="text-white block">Lista de deseos (Wishlist & Want to Buy)</strong>
                                    <span class="text-slate-400">Se añadirán a <em>🟡 Deseados</em> o <em>🔴 Quiero comprar</em></span>
                                </div>
                            </label>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_errorMessage))
                        {
                            <div class="p-3 bg-red-950/50 border border-red-800/60 rounded-xl text-xs text-red-300 flex items-center gap-2">
                                <span>⚠️</span>
                                <span>@_errorMessage</span>
                            </div>
                        }

                        <div class="pt-2 flex gap-3">
                            <button type="button" 
                                    @onclick="Close"
                                    class="flex-1 py-2.5 px-4 rounded-xl font-bold text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors">
                                Cancelar
                            </button>
                            <button type="button" 
                                    @onclick="StartImportAsync"
                                    disabled="@(string.IsNullOrWhiteSpace(_username))"
                                    class="flex-1 py-2.5 px-4 rounded-xl font-bold text-xs bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-all disabled:opacity-50 disabled:cursor-not-allowed shadow-md shadow-emerald-500/10">
                                Importar Colección
                            </button>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnImportCompleted { get; set; }

    private string _username = string.Empty;
    private bool _importOwned = true;
    private bool _importWishlist = true;
    private bool _isProcessing = false;
    private string? _errorMessage;
    private BggImportResultDto? _result;

    private async Task StartImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_username)) return;

        _isProcessing = true;
        _errorMessage = null;
        _result = null;

        try
        {
            var request = new BggImportRequest(_username.Trim(), _importOwned, _importWishlist);
            _result = await BggImportService.ImportUserCollectionAsync(request);
        }
        catch (Exception ex)
        {
            _errorMessage = $"No se pudo importar la colección: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task Close()
    {
        _result = null;
        _errorMessage = null;
        await OnClose.InvokeAsync();
    }

    private async Task CloseAndRefresh()
    {
        _result = null;
        _errorMessage = null;
        await OnImportCompleted.InvokeAsync();
        await OnClose.InvokeAsync();
    }
}
