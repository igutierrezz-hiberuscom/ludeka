@using Ludeka.Core.Enums
@using Ludeka.Application.DTOs

<div class="rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] p-4 sm:p-5 shadow-sm">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)] tracking-wider block mb-1">
                Tu Ludoteca Personal
            </span>
            <p class="text-xs text-[var(--text-secondary)]">
                @if (CurrentItem != null)
                {
                    <span>Estado actual: <strong class="text-[var(--text-primary)]">@GetStatusName(CurrentItem.Status)</strong></span>
                }
                else
                {
                    <span>Añade este título a tu colección lúdica:</span>
                }
            </p>
        </div>

        @if (CurrentItem?.Status == CollectionStatus.InCollection)
        {
            <div class="w-full sm:w-auto flex items-center gap-2">
                @if (ActiveLoan != null)
                {
                    <button type="button"
                            @onclick="OnLoanClicked"
                            class="w-full sm:w-auto px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-500/10 text-amber-500 dark:text-amber-300 border border-amber-500/30 hover:bg-amber-500/20 transition-all flex items-center justify-center gap-1.5 shadow-sm">
                        <span>📦</span>
                        <span>Prestado a <strong>@ActiveLoan.BorrowerName</strong></span>
                    </button>
                }
                else
                {
                    <button type="button"
                            @onclick="OnLoanClicked"
                            class="w-full sm:w-auto px-3 py-1.5 rounded-lg text-xs font-semibold bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] transition-all flex items-center justify-center gap-1.5 shadow-sm">
                        <span>🤝</span>
                        <span>Prestar juego</span>
                    </button>
                }
            </div>
        }
    </div>

    @* Barra de 4 acciones estilo Letterboxd *@
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4" role="group" aria-label="Estados de colección">
        @* 1. En mi ludoteca *@
        <button type="button"
                @onclick="() => HandleStatusClick(CollectionStatus.InCollection)"
                class="px-3 py-2.5 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-2 @GetButtonStyle(CollectionStatus.InCollection)">
            <span>📚</span>
            <span>En mi ludoteca</span>
        </button>

        @* 2. Jugado *@
        <button type="button"
                @onclick="() => HandleStatusClick(CollectionStatus.Played)"
                class="px-3 py-2.5 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-2 @GetButtonStyle(CollectionStatus.Played)">
            <span>🎲</span>
            <span>Jugado</span>
        </button>

        @* 3. Deseado *@
        <button type="button"
                @onclick="() => HandleStatusClick(CollectionStatus.Wishlist)"
                class="px-3 py-2.5 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-2 @GetButtonStyle(CollectionStatus.Wishlist)">
            <span>🔖</span>
            <span>Deseado</span>
        </button>

        @* 4. Quiero comprar *@
        <button type="button"
                @onclick="() => HandleStatusClick(CollectionStatus.WantToBuy)"
                class="px-3 py-2.5 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-2 @GetButtonStyle(CollectionStatus.WantToBuy)">
            <span>🛒</span>
            <span>Comprar</span>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public UserCollectionItemDto? CurrentItem { get; set; }

    [Parameter]
    public GameLoanDto? ActiveLoan { get; set; }

    [Parameter]
    public EventCallback<CollectionStatus> OnStatusSelected { get; set; }

    [Parameter]
    public EventCallback OnLoanClicked { get; set; }

    private async Task HandleStatusClick(CollectionStatus status)
    {
        await OnStatusSelected.InvokeAsync(status);
    }

    private string GetButtonStyle(CollectionStatus status)
    {
        bool isSelected = CurrentItem?.Status == status;

        if (!isSelected)
        {
            return "bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] hover:border-[var(--border-highlight)]";
        }

        return "bg-[var(--brand-glow)] text-[var(--text-primary)] border-2 border-[var(--brand-primary)] font-bold shadow-sm";
    }

    private static string GetStatusName(CollectionStatus status) => status switch
    {
        CollectionStatus.InCollection => "En mi ludoteca",
        CollectionStatus.Played => "Jugado",
        CollectionStatus.Wishlist => "En lista de deseos",
        CollectionStatus.WantToBuy => "En seguimiento para comprar",
        _ => status.ToString()
    };
}
