@* Imagen por defecto de Ludeka (INC-35, spec default-image-fallbacks): SVG INLINE temable
   con variables de tema para los 5 data-theme. Motivo por dominio: carrusel de feria
   (evento), caja con lazo (sorteo), etiqueta con destello (novedad) e isotipo de dados
   (genérico). Un dominio sin variante soportada cae en la genérica sin fallar ni quedar
   en blanco. Con Alt (señal semántica) se expone role="img" con texto accesible; sin Alt
   es decorativo (aria-hidden="true"). Para el caso onerror existe la variante estática
   servida desde /images/defaults/ (DefaultImageAssets.Url). *@
<svg viewBox="0 0 400 225" class="@CssClass" preserveAspectRatio="xMidYMid slice" role="@(Alt is null ? null : "img")" aria-hidden="@(Alt is null ? "true" : null)" aria-label="@Alt">
    <rect width="400" height="225" fill="var(--bg-surface-elevated)" />
    <circle cx="200" cy="96" r="72" fill="var(--brand-glow)" />
    <rect x="1" y="1" width="398" height="223" fill="none" stroke="var(--border-subtle)" stroke-width="2" />
    @switch (Domain)
    {
        case DefaultImageDomain.Evento:
            <g transform="translate(152 40) scale(4)" fill="none" stroke="var(--brand-primary)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3.5 21 14 3" />
                <path d="M20.5 21 10 3" />
                <path d="M15.5 21 12 15l-3.5 6" />
                <path d="M2 21h20" />
            </g>
            @Microtexto("EVENTO LUDEKA")
            break;
        case DefaultImageDomain.Sorteo:
            <g transform="translate(152 40) scale(4)" fill="none" stroke="var(--brand-primary)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="8" width="18" height="4" rx="1" />
                <path d="M12 8v13" />
                <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
                <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5" />
            </g>
            @Microtexto("SORTEO LUDEKA")
            break;
        case DefaultImageDomain.Novedad:
            <g transform="translate(152 40) scale(4)" fill="none" stroke="var(--brand-primary)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" />
                <path d="M20 3v4" />
                <path d="M22 5h-4" />
                <path d="M4 17v2" />
                <path d="M5 18H3" />
            </g>
            @Microtexto("NOVEDAD")
            break;
        default:
            <g transform="translate(152 40) scale(4)" fill="none" stroke="var(--brand-primary)" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                <rect width="12" height="12" x="2" y="10" rx="2" ry="2" />
                <path d="m17.92 14 3.5-3.5a2.24 2.24 0 0 0 0-3l-5-4.92a2.24 2.24 0 0 0-3 0L10 6" />
                <path d="M6 18h.01" />
                <path d="M10 14h.01" />
                <path d="M15 6h.01" />
                <path d="M18 9h.01" />
            </g>
            @Microtexto("LUDEKA")
            break;
    }
</svg>

@code {
    /// <summary>Dominio del dato sin imagen; define el motivo del SVG.</summary>
    [Parameter, EditorRequired] public DefaultImageDomain Domain { get; set; }

    /// <summary>Texto accesible si el SVG acompaña contenido sin imagen propia; null => decorativo.</summary>
    [Parameter] public string? Alt { get; set; }

    /// <summary>Clase CSS para dimensionar el SVG en el contenedor (p. ej. "w-full h-full").</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// Microtexto del asset (evento/sorteo/novedad/genérico). Razor interpreta la etiqueta
    /// SVG de texto como transición propia (RZ1023), así que se emite como marcado
    /// controlado y constante del equipo (nunca entrada de usuario).
    /// </summary>
    private static MarkupString Microtexto(string etiqueta) =>
        new($@"<text x=""200"" y=""196"" text-anchor=""middle"" font-family=""'Plus Jakarta Sans', sans-serif"" font-size=""12"" font-weight=""700"" letter-spacing=""3.5"" fill=""var(--text-secondary)"">{System.Net.WebUtility.HtmlEncode(etiqueta)}</text>");
}

