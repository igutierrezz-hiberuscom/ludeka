@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums

<div class="rounded-2xl border p-6 sm:p-7 relative overflow-hidden transition-all duration-300 @GetCardContainerStyle(Verdict.Recommendation)">
    @* Ambient gradient background *@
    <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full opacity-10 blur-3xl pointer-events-none @GetGlowStyle(Verdict.Recommendation)"></div>

    @* Header: Sello y Autoría *@
    <div class="flex flex-wrap items-center justify-between gap-3 pb-5 border-b border-[var(--border-subtle)]">
        <div class="flex items-center gap-3">
            <span class="text-xs uppercase font-extrabold tracking-wider px-3 py-1 rounded-full border @GetBadgeStyle(Verdict.Recommendation)">
                @Verdict.RecommendationLabel
            </span>
            <span class="text-xs text-[var(--text-secondary)]">
                Por <strong class="text-[var(--text-primary)]">@Verdict.AuthorName</strong>
            </span>
        </div>
        <div class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
            <span>🛡️ Veredicto Editorial</span>
            <span>&bull;</span>
            <span>@Verdict.UpdatedAt.ToString("dd/MM/yyyy")</span>
        </div>
    </div>

    @* Navigation Tabs de Análisis *@
    <div class="mt-5">
        <div class="flex flex-wrap gap-2 border-b border-[var(--border-subtle)] pb-3">
            <button type="button"
                    @onclick="() => _activeTab = TabGeneral"
                    class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(_activeTab == TabGeneral ? "bg-[var(--brand-primary)] text-white shadow-sm" : "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)]")">
                <span>✍️</span> Análisis de la Casa
            </button>
            <button type="button"
                    @onclick="() => _activeTab = TabTwoPlayers"
                    class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(_activeTab == TabTwoPlayers ? "bg-[var(--brand-primary)] text-white shadow-sm" : "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)]")">
                <span>👥</span> A 2 Jugadores (En Pareja)
            </button>
            <button type="button"
                    @onclick="() => _activeTab = TabFamily"
                    class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 @(_activeTab == TabFamily ? "bg-[var(--brand-primary)] text-white shadow-sm" : "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)]")">
                <span>🧒</span> Con Niños y Familias
            </button>
        </div>

        @* Tab Content *@
        <div class="pt-4 text-sm leading-relaxed text-[var(--text-primary)] min-h-[5rem]">
            @if (_activeTab == TabGeneral)
            {
                <div class="animate-fadeIn space-y-2">
                    <p class="font-medium text-[var(--text-secondary)]">@Verdict.OverallVerdict</p>
                </div>
            }
            else if (_activeTab == TabTwoPlayers)
            {
                <div class="animate-fadeIn space-y-2">
                    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-secondary)] text-xs font-bold mb-2">
                        <span>⚖️ Ritmo, Tensión y Mapa a 2 Comensales</span>
                    </div>
                    <p class="font-medium text-[var(--text-secondary)]">@Verdict.TwoPlayerVerdict</p>
                </div>
            }
            else if (_activeTab == TabFamily)
            {
                <div class="animate-fadeIn space-y-2">
                    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-secondary)] text-xs font-bold mb-2">
                        <span>🧩 Adaptaciones y Experiencia Infantil Real</span>
                    </div>
                    <p class="font-medium text-[var(--text-secondary)]">@Verdict.FamilyVerdict</p>
                </div>
            }
        </div>
    </div>

    @* Galería de Fotos Reales de Partida *@
    @if (Verdict.Photos.Count > 0)
    {
        <div class="mt-6 pt-5 border-t border-[var(--border-subtle)]">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xs font-extrabold uppercase tracking-wider text-[var(--text-secondary)] flex items-center gap-1.5">
                    <span>📸</span> En Nuestra Mesa: Fotos Reales de Partida
                </h3>
                <span class="text-[0.68rem] text-[var(--text-muted)]">@Verdict.Photos.Count @(Verdict.Photos.Count == 1 ? "foto real" : "fotos reales")</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                @for (int i = 0; i < Verdict.Photos.Count; i++)
                {
                    var photo = Verdict.Photos[i];
                    var index = i;
                    <div class="group relative rounded-xl overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] cursor-pointer transition-all hover:border-[var(--brand-primary)] shadow-md"
                         @onclick="() => _previewPhoto = photo">
                        <div class="aspect-video overflow-hidden bg-[var(--bg-surface)] flex items-center justify-center">
                            <img src="@photo.PhotoUrl" alt="@photo.Caption" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                        </div>
                        <div class="p-2.5 bg-[var(--bg-card)] text-xs">
                            <p class="text-[var(--text-secondary)] text-[0.75rem] line-clamp-2 leading-snug">@photo.Caption</p>
                            <span class="text-[0.65rem] text-[var(--brand-primary)] font-bold block mt-1">🔍 Ampliar foto</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* Lightbox Modal de Foto Real *@
    @if (_previewPhoto != null)
    {
        <div class="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 animate-fadeIn"
             role="dialog"
             aria-modal="true"
             aria-label="Ampliación de fotografía de mesa real"
             @onclick="() => _previewPhoto = null">
            <div class="max-w-3xl w-full bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-2xl overflow-hidden shadow-2xl relative"
                 @onclick:stopPropagation="true">
                <button type="button"
                        @onclick="() => _previewPhoto = null"
                        aria-label="Cerrar ampliación de fotografía"
                        class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-black/70 text-white hover:bg-[var(--brand-primary)] flex items-center justify-center text-sm font-bold transition-colors">
                    ✕
                </button>
                <div class="max-h-[70vh] bg-black flex items-center justify-center overflow-hidden">
                    <img src="@_previewPhoto.PhotoUrl" alt="@_previewPhoto.Caption" loading="lazy" decoding="async" class="max-w-full max-h-[70vh] object-contain" />
                </div>
                <div class="p-4 bg-[var(--bg-surface)] border-t border-[var(--border-subtle)] flex items-center justify-between">
                    <p class="text-sm font-semibold text-[var(--text-primary)]">@_previewPhoto.Caption</p>
                    <span class="text-xs px-2 py-1 rounded bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] shrink-0 ml-3">📸 Foto de mesa física</span>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public FoundingVerdictDto Verdict { get; set; } = null!;

    private const string TabGeneral = "general";
    private const string TabTwoPlayers = "two-players";
    private const string TabFamily = "family";

    private string _activeTab = TabGeneral;
    private FoundingPhotoDto? _previewPhoto;

    private static string GetCardContainerStyle(FoundingRecommendation rec) => rec switch
    {
        FoundingRecommendation.MustPlay => "bg-[var(--bg-card)] border-[var(--border-subtle)] shadow-xl",
        FoundingRecommendation.RecommendedWithAdaptations => "bg-[var(--bg-card)] border-[var(--border-subtle)] shadow-xl",
        FoundingRecommendation.Skippable => "bg-[var(--bg-card)] border-[var(--border-subtle)] shadow-lg",
        _ => "bg-[var(--bg-card)] border-[var(--border-subtle)]"
    };

    private static string GetGlowStyle(FoundingRecommendation rec) => rec switch
    {
        FoundingRecommendation.MustPlay => "bg-[var(--brand-primary)]",
        FoundingRecommendation.RecommendedWithAdaptations => "bg-[var(--brand-primary)]",
        FoundingRecommendation.Skippable => "bg-[var(--text-muted)]",
        _ => "bg-[var(--brand-primary)]"
    };

    private static string GetBadgeStyle(FoundingRecommendation rec) => rec switch
    {
        FoundingRecommendation.MustPlay => "bg-[var(--bg-surface-elevated)] text-[var(--brand-primary)] border-[var(--border-subtle)]",
        FoundingRecommendation.RecommendedWithAdaptations => "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border-[var(--border-subtle)]",
        FoundingRecommendation.Skippable => "bg-[var(--bg-surface-elevated)] text-[var(--text-muted)] border-[var(--border-subtle)]",
        _ => "bg-[var(--bg-surface-elevated)] text-[var(--text-secondary)] border-[var(--border-subtle)]"
    };
}
