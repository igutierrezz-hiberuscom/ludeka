@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects

<div class="rounded-2xl border transition-all duration-300 overflow-hidden flex flex-col justify-between @(Giveaway.IsExpired ? "bg-[var(--bg-card)] border-[var(--border-subtle)] opacity-60" : "bg-[var(--bg-card)] border-[var(--border-subtle)] hover:border-[var(--brand-primary)] hover:shadow-lg shadow-sm")">
    <div>
        @if (!string.IsNullOrWhiteSpace(Giveaway.ThumbnailUrl))
        {
            <div class="w-full h-44 overflow-hidden bg-[var(--bg-surface)] relative border-b border-[var(--border-subtle)]">
                <img src="@Giveaway.ThumbnailUrl" alt="Cartel de @Giveaway.Title" class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" loading="lazy" />
                @if (Giveaway.IsPromoted)
                {
                    <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg text-xs font-black bg-amber-500 text-black shadow-md flex items-center gap-1">
                        <Icon Name="star" Size="12" /> Promocionado
                    </span>
                }
            </div>
        }

        @* Cabecera y Badges de Estado *@
        <div class="p-5 pb-3 flex items-start justify-between gap-3">
            <div class="flex items-center gap-2 flex-wrap">
                @if (Giveaway.IsPromoted && string.IsNullOrWhiteSpace(Giveaway.ThumbnailUrl))
                {
                    <span class="px-2.5 py-1 rounded-lg text-xs font-black bg-amber-500/20 text-amber-500 border border-amber-500/40 flex items-center gap-1 shadow-sm">
                        <Icon Name="star" Size="12" /> Promocionado
                    </span>
                }

                @* Badge Territorial / Bandera *@
                <span class="px-2.5 py-1 rounded-lg text-xs font-bold border flex items-center gap-1.5 bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]">
                    <span>@CountryCatalog.GetFlag(Giveaway.Country)</span>
                    <span>@(Giveaway.IsInternational ? "Internacional" : Giveaway.Country)</span>
                </span>

                <span class="px-2.5 py-1 rounded-lg text-xs font-bold tracking-wide border flex items-center gap-1.5 @GetPlatformBadgeClass(Giveaway.Platform)">
                    <Icon Name="@GetPlatformIcon(Giveaway.Platform)" Size="12" />
                    <span>@Giveaway.Platform</span>
                </span>

                @if (Giveaway.IsCommunityExclusive)
                {
                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-[var(--brand-glow)] text-[var(--brand-primary)] border border-[var(--brand-primary)] flex items-center gap-1">
                        <Icon Name="gift" Size="12" /> Exclusivo Comunidad
                    </span>
                }
            </div>

            @* Countdown / Tiempo Restante *@
            <span class="px-2.5 py-1 rounded-full text-xs font-bold border @GetCountdownBadgeClass(Giveaway.IsExpired, Giveaway.RemainingTimeText)">
                @Giveaway.RemainingTimeText
            </span>
        </div>

        @* Contenido Central: Título y Organización *@
        <div class="px-5 py-2">
            <h3 class="text-base sm:text-lg font-black text-[var(--text-primary)] leading-snug group-hover:text-[var(--brand-primary)] transition-colors">
                @Giveaway.Title
            </h3>

            @* Fusión de colaboraciones destacada *@
            <p class="text-xs text-[var(--text-secondary)] mt-2 flex items-center gap-1.5">
                <span class="text-[var(--text-muted)]">Organizado por:</span>
                <strong class="text-[var(--text-primary)] font-semibold">@Giveaway.FormattedOrganizer</strong>
            </p>

            @if (!string.IsNullOrWhiteSpace(Giveaway.GameTitle))
            {
                <div class="mt-3 inline-flex items-center gap-2 px-3 py-1 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-xs text-[var(--text-secondary)]">
                    <Icon Name="dices" Size="12" />
                    <span>Juego: <strong class="text-[var(--text-primary)]">@Giveaway.GameTitle</strong></span>
                </div>
            }
        </div>
    </div>

    @* Footer de la Tarjeta con Enlace Oficial y Controles de Moderación *@
    <div class="p-5 pt-3 border-t border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] flex items-center justify-between gap-3 mt-4">
        <div class="flex flex-col">
            <span class="text-[0.68rem] text-[var(--text-muted)]">
                Límite: @Giveaway.DeadlineAt.ToString("dd/MM/yyyy HH:mm")
            </span>
            @if (CanModerate && OnTogglePromoted.HasDelegate)
            {
                <button type="button"
                        @onclick="() => OnTogglePromoted.InvokeAsync(Giveaway.Id)"
                        class="mt-1 text-[0.65rem] font-bold text-left underline transition-colors @(Giveaway.IsPromoted ? "text-amber-500 hover:text-amber-600" : "text-[var(--text-muted)] hover:text-[var(--text-primary)]")">
                    @(Giveaway.IsPromoted ? "Quitar Promocionado" : "Marcar Promocionado")
                </button>
            }
            @if (Giveaway.IsPublishedOnInstagram && !string.IsNullOrWhiteSpace(Giveaway.InstagramPermalink))
            {
                <a href="@Giveaway.InstagramPermalink"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="mt-1 inline-flex items-center gap-1 text-[0.65rem] font-bold text-pink-500 hover:text-pink-600 dark:text-pink-400">
                    <Icon Name="camera" Size="12" /> <span>Publicado en Instagram</span> <span>↗</span>
                </a>
            }
            else if (CanModerate)
            {
                <a href="/admin/instagram?sourceType=Giveaway&sourceId=@Giveaway.Id"
                   class="mt-1 inline-flex items-center gap-1 text-[0.65rem] font-bold text-sky-500 hover:text-sky-600 dark:text-sky-400">
                    <Icon Name="camera" Size="12" /> <span>Crear Post Instagram</span>
                </a>
            }
        </div>

        <a href="@Giveaway.Url"
           target="_blank"
           rel="noopener noreferrer"
           class="px-3.5 py-1.5 rounded-xl bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white font-bold text-xs transition-colors inline-flex items-center gap-1.5 shadow-sm">
            <span>Participar</span>
            <span>&rarr;</span>
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public GiveawayDto Giveaway { get; set; } = null!;

    [Parameter]
    public bool CanModerate { get; set; }

    [Parameter]
    public EventCallback<Guid> OnTogglePromoted { get; set; }

    private string GetPlatformIcon(GiveawayPlatform platform) => platform switch
    {
        GiveawayPlatform.Instagram => "camera",
        GiveawayPlatform.TwitterX => "twitter",
        GiveawayPlatform.YouTube => "clapperboard",
        GiveawayPlatform.Community => "dices",
        _ => "link"
    };

    private string GetPlatformBadgeClass(GiveawayPlatform platform) => "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)]";

    private string GetCountdownBadgeClass(bool isExpired, string remainingText)
    {
        if (isExpired)
            return "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-muted)]";

        if (remainingText.Contains("horas", StringComparison.OrdinalIgnoreCase))
            return "bg-rose-500/15 border-rose-500/30 text-rose-600 dark:text-rose-400 animate-pulse";

        return "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-primary)]";
    }
}
