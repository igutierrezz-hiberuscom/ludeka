@using System
@using Ludeka.Application.DTOs

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="loan-modal-title"
         @onclick="HandleBackdropClick">
        <div class="w-full max-w-md bg-slate-900 border border-slate-700/80 rounded-2xl shadow-2xl p-6 text-left relative overflow-hidden"
             @onclick:stopPropagation="true">
            
            @* Header *@
            <div class="flex items-center justify-between pb-4 border-b border-slate-800">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">📦</span>
                    <h3 id="loan-modal-title" class="text-base font-black text-white">
                        @(ActiveLoan != null ? "Préstamo Activo" : "Registrar Préstamo")
                    </h3>
                </div>
                <button type="button" @onclick="Close"
                        aria-label="Cerrar modal de préstamo"
                        class="text-slate-400 hover:text-white p-1 rounded-lg text-lg transition-colors">
                    &times;
                </button>
            </div>

            @* Body *@
            <div class="py-4 space-y-4">
                @if (ActiveLoan != null)
                {
                    @* Ficha de préstamo activo *@
                    <div class="p-4 rounded-xl bg-amber-950/40 border border-amber-500/40 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs uppercase font-bold text-amber-400">Prestatario</span>
                            <span class="text-sm font-black text-white">@ActiveLoan.BorrowerName</span>
                        </div>
                        <div class="flex items-center justify-between text-xs text-slate-300">
                            <span>Fecha de entrega:</span>
                            <span class="font-semibold text-slate-200">@ActiveLoan.LoanDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ActiveLoan.Notes))
                        {
                            <div class="text-xs text-slate-400 pt-2 border-t border-amber-900/40">
                                <em>Notas: @ActiveLoan.Notes</em>
                            </div>
                        }
                    </div>

                    <p class="text-xs text-slate-400">
                        ¿Ya recuperaste la copia física de tu juego de mesa?
                    </p>

                    <button type="button"
                            @onclick="HandleReturnLoan"
                            class="w-full py-3 px-4 rounded-xl text-xs font-black uppercase tracking-wider bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-950/50 transition-all flex items-center justify-center gap-2">
                        <span>↩️</span>
                        <span>Marcar como devuelto (1 clic)</span>
                    </button>
                }
                else
                {
                    @* Formulario de nuevo préstamo *@
                    <p class="text-xs text-slate-400">
                        Apunta a quién le has dejado este juego para no perderle la pista jamás en tu perfil.
                    </p>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="p-3 rounded-xl bg-rose-950/70 border border-rose-600/60 text-rose-300 text-xs font-semibold">
                            @_errorMessage
                        </div>
                    }

                    <div class="space-y-3">
                        <div>
                            <label for="loan-borrower-name" class="block text-xs font-bold text-slate-300 mb-1">
                                Persona o Asociación <span class="text-rose-400">*</span>
                            </label>
                            <input id="loan-borrower-name"
                                   type="text"
                                   @bind="_borrowerName"
                                   placeholder="Ej. Carlos (Asociación Ludens)"
                                   class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-orange-500" />
                        </div>

                        <div>
                            <label for="loan-date-input" class="block text-xs font-bold text-slate-300 mb-1">
                                Fecha del Préstamo
                            </label>
                            <input id="loan-date-input"
                                   type="date"
                                   @bind="_loanDate"
                                   class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white focus:outline-none focus:border-orange-500" />
                        </div>

                        <div>
                            <label for="loan-notes-input" class="block text-xs font-bold text-slate-300 mb-1">
                                Notas o contacto (opcional)
                            </label>
                            <input id="loan-notes-input"
                                   type="text"
                                   @bind="_notes"
                                   placeholder="Ej. Lo devuelve en la quedada del jueves"
                                   class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-orange-500" />
                        </div>
                    </div>

                    <div class="pt-3 flex gap-3">
                        <button type="button" @onclick="Close"
                                class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors">
                            Cancelar
                        </button>
                        <button type="button"
                                @onclick="HandleCreateLoan"
                                class="flex-1 py-2.5 px-4 rounded-xl text-xs font-black uppercase tracking-wider bg-orange-600 hover:bg-orange-500 text-white shadow-lg shadow-orange-950/50 transition-all">
                            Prestar
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public GameLoanDto? ActiveLoan { get; set; }

    [Parameter]
    public EventCallback<CreateLoanRequest> OnCreateLoan { get; set; }

    [Parameter]
    public EventCallback<Guid> OnReturnLoan { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string _borrowerName = string.Empty;
    private DateTime _loanDate = DateTime.Today;
    private string? _notes;
    private string? _errorMessage;

    private async Task HandleCreateLoan()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_borrowerName))
        {
            _errorMessage = "Por favor indica el nombre de la persona o asociación.";
            return;
        }

        var req = new CreateLoanRequest(Guid.Empty, _borrowerName, new DateTimeOffset(_loanDate), _notes);
        await OnCreateLoan.InvokeAsync(req);
        _borrowerName = string.Empty;
        _notes = null;
        await Close();
    }

    private async Task HandleReturnLoan()
    {
        if (ActiveLoan != null)
        {
            await OnReturnLoan.InvokeAsync(ActiveLoan.Id);
            await Close();
        }
    }

    private async Task Close()
    {
        _errorMessage = null;
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }
}
