@if (IsOpen && Item != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fade-in"
         @onclick="HandleBackdropClick">
        <div class="bg-slate-900 border border-slate-700/80 rounded-2xl w-full max-w-3xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]"
             @onclick:stopPropagation="true">
            
            @* Cabecera del modal *@
            <div class="p-4 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
                <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-xl">
                        @if (Item.Type == MediaType.Tutorial)
                        {
                            <span>🎬</span>
                        }
                        else if (Item.Type == MediaType.Playthrough)
                        {
                            <span>🎲</span>
                        }
                        else if (Item.Type == MediaType.InstagramPost)
                        {
                            <span>📸</span>
                        }
                        else
                        {
                            <span>📱</span>
                        }
                    </span>
                    <div class="min-w-0">
                        <h3 class="text-sm font-bold text-white truncate max-w-md">
                            @Item.Title
                        </h3>
                        <p class="text-xs text-orange-400 font-medium">
                            @Item.AuthorChannel &bull; <span class="text-slate-400">@Item.Platform</span>
                        </p>
                    </div>
                </div>

                <button type="button"
                        @onclick="CloseModal"
                        class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
                        aria-label="Cerrar modal">
                    ✕
                </button>
            </div>

            @* Cuerpo con reproductor o visualizador *@
            <div class="bg-black flex-1 flex items-center justify-center overflow-hidden">
                @if (Item.Platform == MediaPlatform.YouTube && !string.IsNullOrWhiteSpace(Item.EmbedUrl))
                {
                    <div class="w-full aspect-video">
                        <iframe src="@Item.EmbedUrl"
                                title="@Item.Title"
                                class="w-full h-full"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen>
                        </iframe>
                    </div>
                }
                else
                {
                    <div class="p-8 text-center max-w-md mx-auto space-y-4">
                        <div class="rounded-xl overflow-hidden shadow-lg border border-slate-700 mx-auto max-w-xs">
                            <img src="@Item.ThumbnailUrl" alt="@Item.Title" class="w-full h-auto object-cover" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Item.Excerpt))
                        {
                            <p class="text-xs text-slate-300 italic bg-slate-900/90 p-3 rounded-lg border border-slate-800">
                                "@Item.Excerpt"
                            </p>
                        }
                        <p class="text-xs text-slate-400">
                            Este contenido procede de Instagram y está optimizado para su visualización en la red social.
                        </p>
                    </div>
                }
            </div>

            @* Pie del modal *@
            <div class="p-3.5 border-t border-slate-800 bg-slate-950/60 flex items-center justify-between text-xs">
                <div class="flex items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(Item.PlayerCountBadge))
                    {
                        <span class="px-2 py-0.5 rounded-full bg-emerald-950/80 text-emerald-400 border border-emerald-500/40 font-bold text-[0.68rem]">
                            👥 @Item.PlayerCountBadge
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Item.FormattedDuration))
                    {
                        <span class="px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 font-semibold text-[0.68rem]">
                            ⏱️ @Item.FormattedDuration
                        </span>
                    }
                    @if (Item.LikesCount.HasValue)
                    {
                        <span class="px-2 py-0.5 rounded-full bg-rose-950/80 text-rose-300 border border-rose-500/30 font-semibold text-[0.68rem]">
                            ❤️ @Item.LikesCount likes
                        </span>
                    }
                </div>

                <div class="flex items-center gap-2">
                    <a href="@Item.Url"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="px-3 py-1.5 rounded-lg bg-orange-600 hover:bg-orange-500 text-white font-bold transition-colors inline-flex items-center gap-1.5 shadow-sm">
                        <span>↗</span> Ver en @Item.Platform
                    </a>
                    <button type="button"
                            @onclick="CloseModal"
                            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold transition-colors">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public MediaItemDto? Item { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await CloseModal();
    }
}
