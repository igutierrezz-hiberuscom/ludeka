@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects

<div class="flex flex-wrap items-center gap-1.5" role="list" aria-label="ADN Lúdico y Ficha Rápida">
    @* Confrontación *@
    <div class="badge-pill" role="listitem">
        @switch (Confrontation)
        {
            case ConfrontationType.Cooperative:
                <span>🤝 Cooperativo</span>
                break;
            case ConfrontationType.SemiCooperative:
                <span>🗡️ Semi-coop</span>
                break;
            case ConfrontationType.HiddenRolesOrTeams:
                <span>👥 Roles / Equipos</span>
                break;
            default:
                <span>⚔️ Competitivo</span>
                break;
        }
    </div>

    @* Estilo Lúdico *@
    <div class="badge-pill" role="listitem">
        @switch (Style)
        {
            case GameStyle.Eurogame:
                <span>⚙️ Eurogame</span>
                break;
            case GameStyle.Ameritrash:
                <span>🎲 Temático</span>
                break;
            case GameStyle.PartyGame:
                <span>🎉 Party Game</span>
                break;
            case GameStyle.FillerAbstract:
                <span>🧩 Filler / Abstracto</span>
                break;
            default:
                <span>📖 Narrativo</span>
                break;
        }
    </div>

    @* Modo Solitario Oficial *@
    @if (IsOfficialSolo)
    {
        <div class="badge-pill active-pill" role="listitem">
            <span>👤 Modo Solitario Oficial</span>
        </div>
    }

    @* Edad de caja vs Edad Real *@
    @if (Age != null)
    {
        @if (Age.IsAccessibleEarlier)
        {
            <div class="badge-pill" style="border-color: rgba(16, 185, 129, 0.4); color: #34D399;" role="listitem" title="La comunidad lo considera jugable a partir de @Age.CommunityAge años aunque la caja marque +@Age.BoxAge">
                <span>👶 Accesible antes: @Age.CommunityAge+ años</span>
            </div>
        }
        else
        {
            <div class="badge-pill" role="listitem">
                <span>🎂 @Age.CommunityAge+ años</span>
            </div>
        }
    }

    @* Dependencia del Idioma *@
    <div class="badge-pill" role="listitem">
        @switch (Language)
        {
            case LanguageDependence.None:
                <span title="Solo iconografía">🌐 Idioma: Nulo</span>
                break;
            case LanguageDependence.Low:
                <span title="Textos cortos">🌐 Idioma: Bajo</span>
                break;
            default:
                <span title="Párrafos densos">🌐 Idioma: Alto</span>
                break;
        }
    </div>

    @* Minutos por persona *@
    @if (EstimatedMinutesPerPlayer > 0)
    {
        <div class="badge-pill" role="listitem">
            <span>⏱️ ~@EstimatedMinutesPerPlayer min/jugador</span>
        </div>
    }

    @* Huella en mesa *@
    <div class="badge-pill" role="listitem">
        @switch (Footprint)
        {
            case TableFootprint.SmallTable:
                <span>🪑 Mesa pequeña</span>
                break;
            case TableFootprint.TableMonster:
                <span>🏰 Monstruo de mesa</span>
                break;
            default:
                <span>🍽️ Comedor estándar</span>
                break;
        }
    </div>
</div>

@code {
    [Parameter] public ConfrontationType Confrontation { get; set; }
    [Parameter] public GameStyle Style { get; set; }
    [Parameter] public bool IsOfficialSolo { get; set; }
    [Parameter] public AgeRating? Age { get; set; }
    [Parameter] public LanguageDependence Language { get; set; }
    [Parameter] public int EstimatedMinutesPerPlayer { get; set; }
    [Parameter] public TableFootprint Footprint { get; set; }
}
