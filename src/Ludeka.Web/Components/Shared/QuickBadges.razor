@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects

<div class="flex flex-wrap items-center gap-1.5" role="list" aria-label="ADN Lúdico y Ficha Rápida">
    @* Confrontación *@
    <div class="badge-pill" role="listitem">
        @switch (Confrontation)
        {
            case ConfrontationType.Cooperative:
                <span class="inline-flex items-center gap-1"><Icon Name="handshake" Size="12" /> Cooperativo</span>
                break;
            case ConfrontationType.SemiCooperative:
                <span class="inline-flex items-center gap-1"><Icon Name="swords" Size="12" /> Semi-coop</span>
                break;
            case ConfrontationType.HiddenRolesOrTeams:
                <span class="inline-flex items-center gap-1"><Icon Name="users" Size="12" /> Roles / Equipos</span>
                break;
            default:
                <span class="inline-flex items-center gap-1"><Icon Name="swords" Size="12" /> Competitivo</span>
                break;
        }
    </div>

    @* Estilo Lúdico *@
    <div class="badge-pill" role="listitem">
        @switch (Style)
        {
            case GameStyle.Eurogame:
                <span class="inline-flex items-center gap-1"><Icon Name="settings" Size="12" /> Eurogame</span>
                break;
            case GameStyle.Ameritrash:
                <span class="inline-flex items-center gap-1"><Icon Name="dices" Size="12" /> Temático</span>
                break;
            case GameStyle.PartyGame:
                <span class="inline-flex items-center gap-1"><Icon Name="party-popper" Size="12" /> Party Game</span>
                break;
            case GameStyle.FillerAbstract:
                <span class="inline-flex items-center gap-1"><Icon Name="puzzle" Size="12" /> Filler / Abstracto</span>
                break;
            default:
                <span class="inline-flex items-center gap-1"><Icon Name="book-open" Size="12" /> Narrativo</span>
                break;
        }
    </div>

    @* Modo Solitario Oficial *@
    @if (IsOfficialSolo)
    {
        <div class="badge-pill active-pill" role="listitem">
            <span class="inline-flex items-center gap-1"><Icon Name="user" Size="12" /> Modo Solitario Oficial</span>
        </div>
    }

    @* Edad de caja vs Edad Real *@
    @if (Age != null)
    {
        @if (Age.IsAccessibleEarlier)
        {
            <div class="badge-pill active-pill" role="listitem" title="La comunidad lo considera jugable a partir de @Age.CommunityAge años aunque la caja marque +@Age.BoxAge">
                <span class="inline-flex items-center gap-1"><Icon Name="baby" Size="12" /> Accesible antes: @Age.CommunityAge+ años</span>
            </div>
        }
        else
        {
            <div class="badge-pill" role="listitem">
                <span class="inline-flex items-center gap-1"><Icon Name="cake" Size="12" /> @Age.CommunityAge+ años</span>
            </div>
        }
    }

    @* Dependencia del Idioma *@
    <div class="badge-pill" role="listitem">
        @switch (Language)
        {
            case LanguageDependence.None:
                <span title="Solo iconografía" class="inline-flex items-center gap-1"><Icon Name="globe" Size="12" /> Idioma: Nulo</span>
                break;
            case LanguageDependence.Low:
                <span title="Textos cortos" class="inline-flex items-center gap-1"><Icon Name="globe" Size="12" /> Idioma: Bajo</span>
                break;
            default:
                <span title="Párrafos densos" class="inline-flex items-center gap-1"><Icon Name="globe" Size="12" /> Idioma: Alto</span>
                break;
        }
    </div>

    @* Minutos por persona *@
    @if (EstimatedMinutesPerPlayer > 0)
    {
        <div class="badge-pill" role="listitem">
            <span class="inline-flex items-center gap-1"><Icon Name="timer" Size="12" /> ~@EstimatedMinutesPerPlayer min/jugador</span>
        </div>
    }

    @* Huella en mesa *@
    <div class="badge-pill" role="listitem">
        @switch (Footprint)
        {
            case TableFootprint.SmallTable:
                <span class="inline-flex items-center gap-1"><Icon Name="armchair" Size="12" /> Mesa pequeña</span>
                break;
            case TableFootprint.TableMonster:
                <span class="inline-flex items-center gap-1"><Icon Name="castle" Size="12" /> Monstruo de mesa</span>
                break;
            default:
                <span class="inline-flex items-center gap-1"><Icon Name="utensils" Size="12" /> Comedor estándar</span>
                break;
        }
    </div>
</div>

@code {
    [Parameter] public ConfrontationType Confrontation { get; set; }
    [Parameter] public GameStyle Style { get; set; }
    [Parameter] public bool IsOfficialSolo { get; set; }
    [Parameter] public AgeRating? Age { get; set; }
    [Parameter] public LanguageDependence Language { get; set; }
    [Parameter] public int EstimatedMinutesPerPlayer { get; set; }
    [Parameter] public TableFootprint Footprint { get; set; }
}
