@using System
@using System.Collections.Generic
@using System.Linq
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/60 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="review-sheet-title"
         @onclick="HandleBackdropClick">
        <div class="w-full sm:max-w-xl max-h-[90vh] bg-[var(--bg-card)] border-t sm:border border-[var(--border-subtle)] rounded-t-3xl sm:rounded-2xl shadow-2xl p-5 sm:p-6 text-left relative flex flex-col overflow-hidden"
             @onclick:stopPropagation="true">

            @* Header *@
            <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)] shrink-0">
                <div class="flex items-center gap-2">
                    <Icon Name="zap" Size="24" />
                    <div>
                        <h3 id="review-sheet-title" class="text-base font-bold text-[var(--text-primary)]">
                            @(ExistingReview != null ? "Editar mi Valoración" : "Valoración del Juego")
                        </h3>
                        <p class="text-[0.68rem] text-[var(--text-muted)]">Tu veredicto real ayuda a recalcular el consenso en español</p>
                    </div>
                </div>
                <button type="button" @onclick="Close"
                        aria-label="Cerrar formulario de valoración"
                        class="text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1 rounded-lg text-xl transition-colors">
                    &times;
                </button>
            </div>

            @* Form Body Scrollable *@
            <div class="py-4 space-y-5 overflow-y-auto pr-1">

                @* 1. Puntuación (1.0 a 10.0) *@
                <div class="p-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col items-center gap-2">
                    <span class="text-[0.68rem] uppercase font-bold text-[var(--text-muted)]">Puntuación General</span>
                    <div class="flex items-baseline gap-1.5 text-amber-500">
                        <span class="text-3xl font-black">★ @_score.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
                        <span class="text-xs text-[var(--text-muted)]">/ 10</span>
                    </div>
                    <input type="range" min="1" max="10" step="0.5"
                           value="@_score.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                           @oninput="HandleScoreInput"
                           @onchange="HandleScoreInput"
                           aria-label="Puntuación general del juego del 1 al 10"
                           class="w-full accent-amber-500 cursor-pointer" />
                    <div class="w-full flex justify-between text-[0.62rem] text-[var(--text-muted)] font-bold px-1">
                        <button type="button" @onclick="() => SetScore(1.0)" class="hover:text-[var(--text-primary)] transition-colors">1 (Malo)</button>
                        <button type="button" @onclick="() => SetScore(5.0)" class="hover:text-[var(--text-primary)] transition-colors">5 (Pasable)</button>
                        <button type="button" @onclick="() => SetScore(8.0)" class="hover:text-[var(--text-primary)] transition-colors">8 (Notable)</button>
                        <button type="button" @onclick="() => SetScore(10.0)" class="hover:text-[var(--text-primary)] transition-colors">10 (Obra Maestra)</button>
                    </div>
                </div>

                @* 2. Micro-reseña (Máx. 280 caracteres) *@
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label for="review-microreview-textarea" class="text-xs font-bold text-[var(--text-secondary)]">
                            Micro-reseña (Tu veredicto en pocas palabras)
                        </label>
                        <span class="text-[0.68rem] font-mono @(RemainingChars < 0 ? "text-rose-500 font-bold" : "text-[var(--text-muted)]")">
                            @_microReview.Length / 280
                        </span>
                    </div>
                    <textarea id="review-microreview-textarea"
                              rows="3"
                              @bind="_microReview"
                              @bind:event="oninput"
                              placeholder="¿Qué te pareció el ritmo, el entreturno o el final de partida? Máximo 280 caracteres."
                              class="w-full px-3.5 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] border @(RemainingChars < 0 ? "border-rose-500" : "border-[var(--border-subtle)]") text-sm text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--brand-primary)] resize-none"></textarea>
                    @if (RemainingChars < 0)
                    {
                        <span class="text-[0.68rem] text-rose-500 font-semibold block mt-1">
                            Has superado el límite de 280 caracteres por @(-RemainingChars).
                        </span>
                    }
                </div>

                @* 3. Experiencia por número de jugadores (Chips 1J a 7J+) *@
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">
                        ¿Cómo escala? (Vota solo los comensales que has probado)
                    </label>
                    <p class="text-[0.68rem] text-[var(--text-muted)] mb-3">Toca para encender el número de jugadores y asignar tu semáforo:</p>

                    <div class="space-y-2">
                        @for (int count = 1; count <= 7; count++)
                        {
                            int pCount = count;
                            string label = pCount == 7 ? "7+J" : $"{pCount}J";
                            bool isEnabled = _playerVotes.ContainsKey(pCount);

                            <div class="flex items-center justify-between p-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)]">
                                <button type="button"
                                        @onclick="() => TogglePlayerCount(pCount)"
                                        class="px-3 py-1.5 rounded-lg text-xs font-bold transition-colors @(isEnabled ? "bg-[var(--brand-primary)] text-white" : "bg-[var(--bg-card)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)]")">
                                    @label
                                </button>

                                @if (isEnabled)
                                {
                                    <div class="flex gap-1.5 text-xs">
                                        <button type="button"
                                                @onclick="() => SetPlayerVote(pCount, ScalabilityStatus.MustPlay)"
                                                class="px-2 py-1 rounded-md font-bold transition-all @(_playerVotes[pCount] == ScalabilityStatus.MustPlay ? "bg-emerald-500/20 text-emerald-600 dark:text-emerald-300 border border-emerald-500/40" : "bg-[var(--bg-card)] text-[var(--text-muted)] border border-[var(--border-subtle)]")">
                                            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500" aria-hidden="true"></span> Imprescindible
                                        </button>
                                        <button type="button"
                                                @onclick="() => SetPlayerVote(pCount, ScalabilityStatus.Recommended)"
                                                class="px-2 py-1 rounded-md font-bold transition-all @(_playerVotes[pCount] == ScalabilityStatus.Recommended ? "bg-amber-500/20 text-amber-600 dark:text-amber-300 border border-amber-500/40" : "bg-[var(--bg-card)] text-[var(--text-muted)] border border-[var(--border-subtle)]")">
                                            <span class="inline-block w-2 h-2 rounded-full bg-amber-500" aria-hidden="true"></span> Recomendado
                                        </button>
                                        <button type="button"
                                                @onclick="() => SetPlayerVote(pCount, ScalabilityStatus.NotRecommended)"
                                                class="px-2 py-1 rounded-md font-bold transition-all @(_playerVotes[pCount] == ScalabilityStatus.NotRecommended ? "bg-rose-500/20 text-rose-600 dark:text-rose-300 border border-rose-500/40" : "bg-[var(--bg-card)] text-[var(--text-muted)] border border-[var(--border-subtle)]")">
                                            <span class="inline-block w-2 h-2 rounded-full bg-rose-500" aria-hidden="true"></span> No recomendado
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-[0.68rem] text-[var(--text-muted)] italic">No probado</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* 4. Experiencia Familiar / Infantil (Opcional) *@
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] space-y-3">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" @bind="_playedWithChildren" class="rounded accent-[var(--brand-primary)] w-4 h-4" />
                        <span class="text-xs font-bold text-[var(--text-primary)]" inline-flex items-center gap-1.5"><Icon Name="baby" Size="12" /> Lo he jugado con niños / en familia</span>
                    </label>

                    @if (_playedWithChildren)
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-[var(--border-subtle)]">
                            <div>
                                <label class="block text-[0.68rem] font-semibold text-[var(--text-secondary)] mb-1">
                                    Edad mínima real sugerida
                                </label>
                                <select @bind="_suggestedAge"
                                        class="w-full px-3 py-1.5 rounded-lg bg-[var(--bg-card)] border border-[var(--border-subtle)] text-xs text-[var(--text-primary)] focus:outline-none">
                                    <option value="">(Sin especificar)</option>
                                    <option value="4">4+ años</option>
                                    <option value="6">6+ años</option>
                                    <option value="8">8+ años</option>
                                    <option value="10">10+ años</option>
                                    <option value="12">12+ años</option>
                                    <option value="14">14+ años</option>
                                </select>
                            </div>
                            <div class="flex items-center">
                                <label class="flex items-center gap-2 cursor-pointer mt-4">
                                    <input type="checkbox" @bind="_isAdaptedRules" class="rounded accent-[var(--brand-primary)] w-4 h-4" />
                                    <span class="text-xs text-[var(--text-secondary)]">Reglas adaptadas / simplificadas</span>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                @* 5. Contexto de partida (Proof of play) *@
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">
                        Contexto principal de tus partidas (Opcional)
                    </label>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                        @foreach (var context in Enum.GetValues<PlayContextType>())
                        {
                            bool isSelected = _playContext == context;
                            <button type="button"
                                    @onclick="() => _playContext = isSelected ? null : context"
                                    class="py-2 px-2.5 rounded-xl text-xs font-semibold border transition-all text-center @(isSelected ? "bg-[var(--brand-glow)] border-[var(--brand-primary)] text-[var(--text-primary)] font-bold" : "bg-[var(--bg-surface-elevated)] border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]")">
                                @GetContextLabel(context)
                            </button>
                        }
                    </div>
                </div>

            </div>

            @* Actions *@
            <div class="pt-3 border-t border-[var(--border-subtle)] flex gap-3 shrink-0">
                <button type="button" @onclick="Close"
                        class="flex-1 py-2.5 px-4 rounded-xl text-xs font-semibold bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] border border-[var(--border-subtle)] transition-colors">
                    Cancelar
                </button>
                <button type="button"
                        disabled="@(RemainingChars < 0)"
                        @onclick="HandleSubmit"
                        class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold uppercase tracking-wider bg-[var(--brand-primary)] hover:opacity-90 disabled:opacity-50 text-white shadow-sm transition-opacity">
                    Guardar Valoración
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public UserReviewDto? ExistingReview { get; set; }

    [Parameter]
    public EventCallback<SubmitReviewRequest> OnSubmitReview { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private double _score = 8.0;
    private string _microReview = string.Empty;
    private Dictionary<int, ScalabilityStatus> _playerVotes = [];
    private bool _playedWithChildren;
    private string _suggestedAge = string.Empty;
    private bool _isAdaptedRules;
    private PlayContextType? _playContext;

    private int RemainingChars => 280 - _microReview.Length;

    protected override void OnParametersSet()
    {
        if (ExistingReview != null)
        {
            SetScore(ExistingReview.Score);
            _microReview = ExistingReview.MicroReview ?? string.Empty;
            _playerVotes = ExistingReview.PlayerCountRatings.ToDictionary(v => v.PlayerCount, v => v.Status);

            if (ExistingReview.FamilyExperience != null)
            {
                _playedWithChildren = ExistingReview.FamilyExperience.PlayedWithChildren;
                _suggestedAge = ExistingReview.FamilyExperience.SuggestedMinAge?.ToString() ?? string.Empty;
                _isAdaptedRules = ExistingReview.FamilyExperience.IsAdaptedRules;
            }

            _playContext = ExistingReview.PlayContext;
        }
    }

    private void SetScore(double score)
    {
        _score = Math.Clamp(Math.Round(score * 2.0, MidpointRounding.AwayFromZero) / 2.0, 1.0, 10.0);
    }

    private void HandleScoreInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(raw))
        {
            raw = raw.Replace(',', '.');
            if (double.TryParse(raw, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
            {
                SetScore(parsed);
            }
        }
    }

    private void TogglePlayerCount(int count)
    {
        if (_playerVotes.ContainsKey(count))
        {
            _playerVotes.Remove(count);
        }
        else
        {
            _playerVotes[count] = ScalabilityStatus.Recommended;
        }
    }

    private void SetPlayerVote(int count, ScalabilityStatus status)
    {
        _playerVotes[count] = status;
    }

    private async Task HandleSubmit()
    {
        if (RemainingChars < 0) return;

        var votes = _playerVotes.Select(kv => new UserPlayerCountVote(kv.Key, kv.Value)).ToList();

        UserFamilyExperienceVote? family = null;
        if (_playedWithChildren)
        {
            int? minAge = int.TryParse(_suggestedAge, out int a) ? a : null;
            family = new UserFamilyExperienceVote(true, minAge, _isAdaptedRules);
        }

        var req = new SubmitReviewRequest(
            Guid.Empty,
            _score,
            string.IsNullOrWhiteSpace(_microReview) ? null : _microReview,
            votes,
            family,
            _playContext
        );

        await OnSubmitReview.InvokeAsync(req);
        await Close();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }

    private static string GetContextLabel(PlayContextType ctx) => ctx switch
    {
        PlayContextType.Owned => "Mi copia",
        PlayContextType.ClubOrAssociation => "Club/Asociación",
        PlayContextType.Friends => "Amigos",
        PlayContextType.BoardGameBar => "Bar lúdico",
        PlayContextType.Bga => "BGA / Digital",
        _ => ctx.ToString()
    };
}
