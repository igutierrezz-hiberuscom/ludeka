@using System
@using System.Collections.Generic
@using System.Linq
@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-slate-950/85 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="review-sheet-title"
         @onclick="HandleBackdropClick">
        <div class="w-full sm:max-w-xl max-h-[90vh] bg-slate-900 border-t sm:border border-slate-700/80 rounded-t-3xl sm:rounded-2xl shadow-2xl p-5 sm:p-6 text-left relative flex flex-col overflow-hidden"
             @onclick:stopPropagation="true">

            @* Header *@
            <div class="flex items-center justify-between pb-3 border-b border-slate-800 shrink-0">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">⚡</span>
                    <div>
                        <h3 id="review-sheet-title" class="text-base font-black text-white">
                            @(ExistingReview != null ? "Editar mi Valoración" : "Valoración del Juego")
                        </h3>
                        <p class="text-[0.68rem] text-slate-400">Tu veredicto real ayuda a recalcular el consenso en español</p>
                    </div>
                </div>
                <button type="button" @onclick="Close"
                        aria-label="Cerrar formulario de valoración"
                        class="text-slate-400 hover:text-white p-1 rounded-lg text-xl transition-colors">
                    &times;
                </button>
            </div>

            @* Form Body Scrollable *@
            <div class="py-4 space-y-5 overflow-y-auto pr-1">

                @* 1. Puntuación (1.0 a 10.0) *@
                <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 flex flex-col items-center gap-2">
                    <span class="text-[0.68rem] uppercase font-bold text-slate-400">Puntuación General</span>
                    <div class="flex items-baseline gap-1.5 text-amber-400">
                        <span class="text-3xl font-black">★ @_score.ToString("0.0")</span>
                        <span class="text-xs text-slate-500">/ 10</span>
                    </div>
                    <input type="range" min="1.0" max="10.0" step="0.5"
                           @bind="_score"
                           @bind:event="oninput"
                           aria-label="Puntuación general del juego del 1 al 10"
                           class="w-full accent-amber-500 cursor-pointer" />
                    <div class="w-full flex justify-between text-[0.62rem] text-slate-500 font-bold px-1">
                        <span>1 (Malo)</span>
                        <span>5 (Pasable)</span>
                        <span>8 (Notable)</span>
                        <span>10 (Obra Maestra)</span>
                    </div>
                </div>

                @* 2. Micro-reseña (Máx. 280 caracteres) *@
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label for="review-microreview-textarea" class="text-xs font-bold text-slate-300">
                            Micro-reseña (Tu veredicto en pocas palabras)
                        </label>
                        <span class="text-[0.68rem] font-mono @(RemainingChars < 0 ? "text-rose-400 font-bold" : "text-slate-500")">
                            @_microReview.Length / 280
                        </span>
                    </div>
                    <textarea id="review-microreview-textarea"
                              rows="3"
                              @bind="_microReview"
                              @bind:event="oninput"
                              placeholder="¿Qué te pareció el ritmo, el entreturno o el final de partida? Máximo 280 caracteres."
                              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border @(RemainingChars < 0 ? "border-rose-500" : "border-slate-800") text-sm text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 resize-none"></textarea>
                    @if (RemainingChars < 0)
                    {
                        <span class="text-[0.68rem] text-rose-400 font-semibold block mt-1">
                            Has superado el límite de 280 caracteres por @(-RemainingChars).
                        </span>
                    }
                </div>

                @* 3. Experiencia por número de jugadores (Chips 1J a 7J+) *@
                <div>
                    <label class="block text-xs font-bold text-slate-300 mb-1">
                        ¿Cómo escala? (Vota solo los comensales que has probado)
                    </label>
                    <p class="text-[0.68rem] text-slate-400 mb-3">Toca para encender el número de jugadores y asignar tu semáforo:</p>

                    <div class="space-y-2">
                        @for (int count = 1; count <= 7; count++)
                        {
                            int pCount = count;
                            string label = pCount == 7 ? "7+J" : $"{pCount}J";
                            bool isEnabled = _playerVotes.ContainsKey(pCount);

                            <div class="flex items-center justify-between p-2 rounded-xl bg-slate-950/60 border border-slate-800/80">
                                <button type="button"
                                        @onclick="() => TogglePlayerCount(pCount)"
                                        class="px-3 py-1.5 rounded-lg text-xs font-black transition-colors @(isEnabled ? "bg-orange-600 text-white" : "bg-slate-800 text-slate-400 hover:text-white")">
                                    @label
                                </button>

                                @if (isEnabled)
                                {
                                    <div class="flex gap-1.5 text-xs">
                                        <button type="button"
                                                @onclick="() => SetPlayerVote(pCount, ScalabilityStatus.MustPlay)"
                                                class="px-2 py-1 rounded-md font-bold transition-all @(_playerVotes[pCount] == ScalabilityStatus.MustPlay ? "bg-emerald-900 text-emerald-300 border border-emerald-500 ring-1 ring-emerald-500/40" : "bg-slate-900 text-slate-400")">
                                            🟢 Imprescindible
                                        </button>
                                        <button type="button"
                                                @onclick="() => SetPlayerVote(pCount, ScalabilityStatus.Recommended)"
                                                class="px-2 py-1 rounded-md font-bold transition-all @(_playerVotes[pCount] == ScalabilityStatus.Recommended ? "bg-amber-900 text-amber-300 border border-amber-500 ring-1 ring-amber-500/40" : "bg-slate-900 text-slate-400")">
                                            🟡 Recomendado
                                        </button>
                                        <button type="button"
                                                @onclick="() => SetPlayerVote(pCount, ScalabilityStatus.NotRecommended)"
                                                class="px-2 py-1 rounded-md font-bold transition-all @(_playerVotes[pCount] == ScalabilityStatus.NotRecommended ? "bg-rose-900 text-rose-300 border border-rose-500 ring-1 ring-rose-500/40" : "bg-slate-900 text-slate-400")">
                                            🔴 No recomendado
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-[0.68rem] text-slate-600 italic">No probado</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* 4. Experiencia Familiar / Infantil (Opcional) *@
                <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 space-y-3">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" @bind="_playedWithChildren" class="rounded accent-orange-500 w-4 h-4" />
                        <span class="text-xs font-bold text-slate-200">👶 Lo he jugado con niños / en familia</span>
                    </label>

                    @if (_playedWithChildren)
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-slate-900">
                            <div>
                                <label class="block text-[0.68rem] font-semibold text-slate-400 mb-1">
                                    Edad mínima real sugerida
                                </label>
                                <select @bind="_suggestedAge"
                                        class="w-full px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none">
                                    <option value="">(Sin especificar)</option>
                                    <option value="4">4+ años</option>
                                    <option value="6">6+ años</option>
                                    <option value="8">8+ años</option>
                                    <option value="10">10+ años</option>
                                    <option value="12">12+ años</option>
                                    <option value="14">14+ años</option>
                                </select>
                            </div>
                            <div class="flex items-center">
                                <label class="flex items-center gap-2 cursor-pointer mt-4">
                                    <input type="checkbox" @bind="_isAdaptedRules" class="rounded accent-orange-500 w-4 h-4" />
                                    <span class="text-xs text-slate-300">Reglas adaptadas / simplificadas</span>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                @* 5. Contexto de partida (Proof of play) *@
                <div>
                    <label class="block text-xs font-bold text-slate-300 mb-1.5">
                        Contexto principal de tus partidas (Opcional)
                    </label>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                        @foreach (var context in Enum.GetValues<PlayContextType>())
                        {
                            bool isSelected = _playContext == context;
                            <button type="button"
                                    @onclick="() => _playContext = isSelected ? null : context"
                                    class="py-2 px-2.5 rounded-xl text-xs font-semibold border transition-all text-center @(isSelected ? "bg-orange-950 border-orange-500 text-orange-300 font-bold" : "bg-slate-950/70 border-slate-800 text-slate-400 hover:border-slate-700")">
                                @GetContextLabel(context)
                            </button>
                        }
                    </div>
                </div>

            </div>

            @* Actions *@
            <div class="pt-3 border-t border-slate-800 flex gap-3 shrink-0">
                <button type="button" @onclick="Close"
                        class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors">
                    Cancelar
                </button>
                <button type="button"
                        disabled="@(RemainingChars < 0)"
                        @onclick="HandleSubmit"
                        class="flex-1 py-2.5 px-4 rounded-xl text-xs font-black uppercase tracking-wider bg-orange-600 hover:bg-orange-500 disabled:opacity-50 text-white shadow-lg shadow-orange-950/50 transition-all">
                    Guardar Valoración
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public UserReviewDto? ExistingReview { get; set; }

    [Parameter]
    public EventCallback<SubmitReviewRequest> OnSubmitReview { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private double _score = 8.0;
    private string _microReview = string.Empty;
    private Dictionary<int, ScalabilityStatus> _playerVotes = [];
    private bool _playedWithChildren;
    private string _suggestedAge = string.Empty;
    private bool _isAdaptedRules;
    private PlayContextType? _playContext;

    private int RemainingChars => 280 - _microReview.Length;

    protected override void OnParametersSet()
    {
        if (ExistingReview != null)
        {
            _score = ExistingReview.Score;
            _microReview = ExistingReview.MicroReview ?? string.Empty;
            _playerVotes = ExistingReview.PlayerCountRatings.ToDictionary(v => v.PlayerCount, v => v.Status);

            if (ExistingReview.FamilyExperience != null)
            {
                _playedWithChildren = ExistingReview.FamilyExperience.PlayedWithChildren;
                _suggestedAge = ExistingReview.FamilyExperience.SuggestedMinAge?.ToString() ?? string.Empty;
                _isAdaptedRules = ExistingReview.FamilyExperience.IsAdaptedRules;
            }

            _playContext = ExistingReview.PlayContext;
        }
    }

    private void TogglePlayerCount(int count)
    {
        if (_playerVotes.ContainsKey(count))
        {
            _playerVotes.Remove(count);
        }
        else
        {
            _playerVotes[count] = ScalabilityStatus.Recommended;
        }
    }

    private void SetPlayerVote(int count, ScalabilityStatus status)
    {
        _playerVotes[count] = status;
    }

    private async Task HandleSubmit()
    {
        if (RemainingChars < 0) return;

        var votes = _playerVotes.Select(kv => new UserPlayerCountVote(kv.Key, kv.Value)).ToList();

        UserFamilyExperienceVote? family = null;
        if (_playedWithChildren)
        {
            int? minAge = int.TryParse(_suggestedAge, out int a) ? a : null;
            family = new UserFamilyExperienceVote(true, minAge, _isAdaptedRules);
        }

        var req = new SubmitReviewRequest(
            Guid.Empty,
            _score,
            string.IsNullOrWhiteSpace(_microReview) ? null : _microReview,
            votes,
            family,
            _playContext
        );

        await OnSubmitReview.InvokeAsync(req);
        await Close();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }

    private static string GetContextLabel(PlayContextType ctx) => ctx switch
    {
        PlayContextType.Owned => "🏠 Mi copia",
        PlayContextType.ClubOrAssociation => "🛡️ Club/Asociación",
        PlayContextType.Friends => "👥 Amigos",
        PlayContextType.BoardGameBar => "☕ Bar lúdico",
        PlayContextType.Bga => "💻 BGA / Digital",
        _ => ctx.ToString()
    };
}
