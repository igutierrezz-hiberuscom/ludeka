@using Ludeka.Core.Enums
@using Ludeka.Core.ValueObjects

<div class="scalability-component">
    <div class="flex items-center justify-between mb-2">
        <span class="text-xs uppercase tracking-wider font-bold text-[var(--text-secondary)]">Escalabilidad en Mesa</span>
        @if (!string.IsNullOrWhiteSpace(IdealText))
        {
            <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--color-mustplay)] border border-[var(--border-subtle)] inline-flex items-center gap-1">
                <Icon Name="sparkles" Size="12" /> @IdealText
            </span>
        }
    </div>

    <div class="flex items-center gap-1.5 overflow-x-auto pb-1" role="group" aria-label="Semáforo de jugadores">
        @if (Entries != null && Entries.Count > 0)
        {
            @foreach (var entry in Entries.OrderBy(e => e.PlayerCount))
            {
                var statusClass = entry.Status switch
                {
                    ScalabilityStatus.MustPlay => "status-mustplay",
                    ScalabilityStatus.Recommended => "status-recommended",
                    _ => "status-notrecommended"
                };

                var tooltip = entry.Status switch
                {
                    ScalabilityStatus.MustPlay => $"{entry.DisplayCount}: ¡Imprescindible! ({entry.BestVotes} votos)",
                    ScalabilityStatus.Recommended => $"{entry.DisplayCount}: Recomendado ({entry.RecommendedVotes} votos)",
                    _ => $"{entry.DisplayCount}: No recomendado ({entry.NotRecommendedVotes} votos)"
                };

                <div class="traffic-chip @statusClass" role="img" tabindex="0" title="@tooltip" aria-label="@tooltip">
                    <span class="player-label">@entry.DisplayCount</span>
                    <span class="dot-indicator" aria-hidden="true"></span>
                </div>
            }
        }
        else
        {
            <span class="text-xs text-[var(--text-muted)] italic">Sin datos de escalabilidad</span>
        }
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<ScalabilityEntry>? Entries { get; set; }

    [Parameter]
    public string? IdealText { get; set; }
}
