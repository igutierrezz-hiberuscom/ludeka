@using Ludeka.Core.ValueObjects

<div class="p-4 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)]">
    <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
            <span class="text-lg">🛡️</span>
            <h3 class="font-bold text-sm text-[var(--text-primary)]">Guía de Fundas (Sleeves)</h3>
        </div>
        <span class="text-xs text-[var(--text-secondary)]">Protege tus cartas</span>
    </div>

    @if (Sleeves != null && Sleeves.Count > 0)
    {
        <div class="space-y-3">
            @foreach (var sleeve in Sleeves)
            {
                int packs50 = sleeve.CalculatePacksNeeded(50);
                <div class="p-3 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <div class="font-semibold text-sm text-[var(--text-primary)]">@sleeve.FormatName (@sleeve.DimensionText)</div>
                        <div class="text-xs text-[var(--text-secondary)]">
                            <strong>@sleeve.CardCount</strong> cartas &bull; Necesitas <strong>@packs50</strong> paquetes de 50 fundas
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(sleeve.AffiliateUrl))
                    {
                        <a href="@sleeve.AffiliateUrl" target="_blank" rel="noopener noreferrer sponsored"
                           class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg text-xs font-bold bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white transition-colors shadow-sm">
                            Comprar fundas compatibles &rarr;
                        </a>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-xs text-[var(--text-secondary)] italic">
            ¡Buenas noticias! Este juego no contiene cartas que requieran fundas o no tiene componentes enfundables.
        </p>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<SleeveItem>? Sleeves { get; set; }
}
