@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@inject ISocialCardService SocialCardService
@inject IJSRuntime JS

@if (IsOpen && Data != null)
{
    var card = SocialCardService.GenerateCard(Data);

    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="social-card-modal-title">
        <div class="w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-3xl bg-[var(--bg-card)] border border-[var(--border-subtle)] p-6 shadow-2xl space-y-6">
            @* Cabecera *@
            <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4">
                <div>
                    <span class="text-xs uppercase font-bold tracking-wider text-[var(--brand-primary)]">Automatización Omnicanal</span>
                    <h2 id="social-card-modal-title" class="text-xl font-bold text-[var(--text-primary)] flex items-center gap-2 mt-0.5">
                        <Icon Name="palette" Size="16" /> Generador de Cartel para Instagram (1:1)
                    </h2>
                </div>
                <button type="button"
                        @onclick="Close"
                        class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-2xl px-2"
                        aria-label="Cerrar modal de cartel social">
                    &times;
                </button>
            </div>

            @* Contenido Principal: Previsualización y Copy *@
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
                @* Vista previa del SVG *@
                <div class="space-y-3">
                    <div class="aspect-square w-full rounded-2xl overflow-hidden border border-[var(--border-subtle)] shadow-lg bg-[var(--bg-surface-elevated)] flex items-center justify-center p-2">
                        @((MarkupString)card.SvgContent)
                    </div>

                    <div class="flex items-center justify-between text-[0.7rem] text-[var(--text-muted)] px-1">
                        <span>Formato cuadrado nativo 1080x1080 px</span>
                        <span>Vectorial SVG de alta fidelidad</span>
                    </div>
                </div>

                @* Bloque de Copy y Acciones *@
                <div class="space-y-4 flex flex-col justify-between h-full">
                    <div>
                        <label for="social-caption-textarea" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">
                            Texto del post con hashtags en español
                        </label>
                        <textarea id="social-caption-textarea"
                                  readonly
                                  rows="10"
                                  class="w-full p-3 rounded-2xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] text-[var(--text-primary)] text-xs font-mono leading-relaxed resize-none focus:outline-none focus:border-[var(--brand-primary)]">
@card.InstagramCaption
                        </textarea>
                    </div>

                    @* Botones de Acción *@
                    <div class="space-y-3 pt-2">
                        <button type="button"
                                @onclick="() => CopyToClipboard(card.InstagramCaption)"
                                class="w-full py-3 rounded-xl bg-[var(--brand-primary)] hover:opacity-90 text-white font-bold text-xs transition-opacity flex items-center justify-center gap-2 shadow-sm">
                            @if (_isCopied)
                            {
                                <span>✓ ¡Texto copiado al portapapeles!</span>
                            }
                            else
                            {
                                <Icon Name="clipboard-copy" Size="14" />
                                <span>Copiar Texto para Instagram</span>
                            }
                        </button>

                        <a href="data:image/svg+xml;charset=utf-8,@Uri.EscapeDataString(card.SvgContent)"
                           download="@card.FileName"
                           class="w-full py-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-semibold text-xs transition-colors flex items-center justify-center gap-2">
                            <Icon Name="inbox" Size="14" />
                            <span>Descargar Cartel SVG</span>
                        </a>

                        <p class="text-[0.68rem] text-[var(--text-muted)] text-center">
                            Listo para publicar en Instagram Feed, Threads o canal de Telegram.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public SocialCardDataDto? Data { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool _isCopied;

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _isCopied = true;
            StateHasChanged();
            await Task.Delay(2500);
            _isCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Fallback si el navegador no permite JS clipboard
        }
    }

    private async Task Close()
    {
        _isCopied = false;
        await OnClose.InvokeAsync();
    }
}
