@using Ludeka.Application.Contracts
@using Ludeka.Application.DTOs
@inject ISocialCardService SocialCardService
@inject IJSRuntime JS

@if (IsOpen && Data != null)
{
    var card = SocialCardService.GenerateCard(Data);

    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md animate-fade-in">
        <div class="w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-3xl bg-[#0F172A] border border-slate-700 p-6 shadow-2xl space-y-6">
            @* Cabecera *@
            <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                <div>
                    <span class="text-xs uppercase font-extrabold tracking-wider text-orange-400">Automatización Omnicanal</span>
                    <h2 class="text-xl font-black text-white flex items-center gap-2 mt-0.5">
                        <span>🎨</span> Generador de Cartel para Instagram (1:1)
                    </h2>
                </div>
                <button type="button"
                        @onclick="Close"
                        class="text-slate-400 hover:text-white text-2xl px-2">
                    &times;
                </button>
            </div>

            @* Contenido Principal: Previsualización y Copy *@
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
                @* Vista previa del SVG *@
                <div class="space-y-3">
                    <div class="aspect-square w-full rounded-2xl overflow-hidden border border-slate-700 shadow-2xl bg-[#0B0F17] flex items-center justify-center p-2">
                        @((MarkupString)card.SvgContent)
                    </div>

                    <div class="flex items-center justify-between text-[0.7rem] text-slate-400 px-1">
                        <span>Formato cuadrado nativo 1080x1080 px</span>
                        <span>Vectorial SVG de alta fidelidad</span>
                    </div>
                </div>

                @* Bloque de Copy y Acciones *@
                <div class="space-y-4 flex flex-col justify-between h-full">
                    <div>
                        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                            Texto del post con hashtags en español
                        </label>
                        <textarea readonly
                                  rows="10"
                                  class="w-full p-3 rounded-2xl bg-slate-900 border border-slate-800 text-slate-200 text-xs font-mono leading-relaxed resize-none focus:outline-none focus:border-orange-500/50">
@card.InstagramCaption
                        </textarea>
                    </div>

                    @* Botones de Acción *@
                    <div class="space-y-3 pt-2">
                        <button type="button"
                                @onclick="() => CopyToClipboard(card.InstagramCaption)"
                                class="w-full py-3 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-extrabold text-xs transition-all flex items-center justify-center gap-2 shadow-lg shadow-orange-950/60">
                            @if (_isCopied)
                            {
                                <span>✓ ¡Texto copiado al portapapeles!</span>
                            }
                            else
                            {
                                <span>📋</span>
                                <span>Copiar Texto para Instagram</span>
                            }
                        </button>

                        <a href="data:image/svg+xml;charset=utf-8,@Uri.EscapeDataString(card.SvgContent)"
                           download="@card.FileName"
                           class="w-full py-3 rounded-xl border border-slate-700 hover:border-slate-500 bg-slate-800/80 hover:bg-slate-800 text-slate-200 font-extrabold text-xs transition-colors flex items-center justify-center gap-2">
                            <span>📥</span>
                            <span>Descargar Cartel SVG</span>
                        </a>

                        <p class="text-[0.68rem] text-slate-500 text-center">
                            Listo para publicar en Instagram Feed, Threads o canal de Telegram.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public SocialCardDataDto? Data { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool _isCopied;

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _isCopied = true;
            StateHasChanged();
            await Task.Delay(2500);
            _isCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Fallback si el navegador no permite JS clipboard
        }
    }

    private async Task Close()
    {
        _isCopied = false;
        await OnClose.InvokeAsync();
    }
}
