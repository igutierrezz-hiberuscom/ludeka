@using Ludeka.Application.DTOs
@using Ludeka.Core.Enums

<div class="rounded-2xl bg-gradient-to-r from-orange-950/40 via-slate-900/60 to-slate-900/40 border border-orange-500/30 p-5 shadow-lg">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <span class="text-[0.68rem] uppercase font-black tracking-wider text-orange-400 block mb-1">
                Tu Opinión y Veredicto
            </span>

            @if (Review != null)
            {
                <div class="flex items-center gap-3">
                    <div class="flex items-baseline gap-1 text-amber-400">
                        <span class="text-2xl font-black">★ @Review.Score.ToString("0.0")</span>
                        <span class="text-xs text-slate-500">/ 10</span>
                    </div>

                    @if (Review.PlayContext.HasValue)
                    {
                        <span class="text-[0.68rem] font-bold px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 border border-slate-700">
                            @GetContextBadge(Review.PlayContext.Value)
                        </span>
                    }

                    @if (Review.FamilyExperience?.PlayedWithChildren == true)
                    {
                        <span class="text-[0.68rem] font-bold px-2 py-0.5 rounded-md bg-purple-950 text-purple-300 border border-purple-700/50">
                            👶 @(Review.FamilyExperience.SuggestedMinAge.HasValue ? $"{Review.FamilyExperience.SuggestedMinAge}+" : "Familiar")
                        </span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Review.MicroReview))
                {
                    <p class="text-xs text-slate-200 mt-2.5 italic">
                        &ldquo;@Review.MicroReview&rdquo;
                    </p>
                }

                @if (Review.PlayerCountRatings.Count > 0)
                {
                    <div class="flex flex-wrap gap-1.5 mt-3">
                        @foreach (var vote in Review.PlayerCountRatings.OrderBy(v => v.PlayerCount))
                        {
                            <span class="text-[0.68rem] font-bold px-2 py-0.5 rounded-md @GetVoteStyle(vote.Status)">
                                @vote.DisplayText: @GetVoteStatusName(vote.Status)
                            </span>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-xs text-slate-300">
                    Aún no has valorado este juego. ¡Tu nota y semáforo personal ayudan a enriquecer el catálogo en español!
                </p>
            }
        </div>

        <button type="button"
                @onclick="OnEditClicked"
                class="w-full sm:w-auto px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-orange-600 hover:bg-orange-500 text-white shadow-md shadow-orange-950/50 transition-all flex items-center justify-center gap-1.5 shrink-0">
            <span>@(Review != null ? "✏️ Editar mi valoración" : "⭐️ Valorar este juego")</span>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public UserReviewDto? Review { get; set; }

    [Parameter]
    public EventCallback OnEditClicked { get; set; }

    private static string GetContextBadge(PlayContextType ctx) => ctx switch
    {
        PlayContextType.Owned => "🏠 En propiedad",
        PlayContextType.ClubOrAssociation => "🛡️ Club / Asociación",
        PlayContextType.Friends => "👥 Amigos",
        PlayContextType.BoardGameBar => "☕ Bar lúdico",
        PlayContextType.Bga => "💻 Digital (BGA)",
        _ => ctx.ToString()
    };

    private static string GetVoteStyle(ScalabilityStatus status) => status switch
    {
        ScalabilityStatus.MustPlay => "bg-emerald-950 text-emerald-300 border border-emerald-500/40",
        ScalabilityStatus.Recommended => "bg-amber-950 text-amber-300 border border-amber-500/40",
        ScalabilityStatus.NotRecommended => "bg-rose-950 text-rose-300 border border-rose-500/40",
        _ => "bg-slate-800 text-slate-300"
    };

    private static string GetVoteStatusName(ScalabilityStatus status) => status switch
    {
        ScalabilityStatus.MustPlay => "🟢 Imprescindible",
        ScalabilityStatus.Recommended => "🟡 Recomendado",
        ScalabilityStatus.NotRecommended => "🔴 No recomendado",
        _ => status.ToString()
    };
}
